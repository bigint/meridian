<%# Search on the left, the person on the right, and on phones the button
    that opens the navigation drawer. %>
<div id="topbar" class="topbar">
  <button type="button" popovertarget="sidebar" class="btn btn--icon btn--plain topbar__menu" aria-label="Menu" data-tooltip="Menu"><%= icon :menu %></button>

  <div class="search" data-controller="jump">
    <%= form_with url: jump_path, method: :get, data: { turbo_frame: "jump_results", jump_target: "form" } do |form| %>
      <%= form.label :q, "Search apps, servers and projects", class: "sr-only" %>
      <%= icon :search, class: "search__icon" %>
      <%= form.search_field :q, placeholder: "Search apps, servers and projects", autocomplete: "off",
            data: { jump_target: "input", action: "input->jump#search keydown->jump#key" } %>
    <% end %>
    <turbo-frame id="jump_results" target="_top" class="search__results" data-action="turbo:before-frame-render->jump#render turbo:frame-load->jump#loaded"></turbo-frame>
  </div>

  <div class="account">
    <button type="button" popovertarget="account" class="account__button" aria-label="Account: <%= current_user.display_name %>">
      <%= avatar current_user.display_name, small: true %>
      <span class="account__name"><%= current_user.display_name %></span>
      <%= icon :chevron, class: "account__chevron" %>
    </button>
    <div id="account" popover class="menu account__menu">
      <div class="menu__section account__who">
        <%= avatar current_user.display_name %>
        <div class="min-w-0">
          <p class="txt-strong truncate"><%= current_user.display_name %></p>
          <p class="txt-small txt-muted truncate"><%= current_user.email_address %></p>
        </div>
        <%= badge current_user.role.capitalize, tone: (:accent if current_user.admin?), class: "ml-auto" %>
      </div>
      <div class="menu__section" data-controller="theme" role="group" aria-labelledby="theme-label">
        <p id="theme-label" class="menu__label">Theme</p>
        <div class="theme-switch">
          <% [ [ "System", nil, :system ], [ "Light", "light", :light ], [ "Dark", "dark", :dark ] ].each do |name, value, icon_name| %>
            <button type="button" data-action="theme#pick" data-theme-target="option" data-theme-choice="<%= value || "system" %>" aria-pressed="<%= theme == value %>"><%= icon icon_name %><%= name %></button>
          <% end %>
        </div>
      </div>
      <div class="menu__section">
        <%= button_to session_path, method: :delete, class: "menu__item", form_class: "block" do %><%= icon :sign_out %>Sign out<% end %>
      </div>
    </div>
  </div>
</div>
