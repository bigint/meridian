<%# Host numbers, drawn by live_stats_controller.js from the frames the agent streams while this page is open.
    Permanent, so a board refresh morphs around it instead of wiping the numbers and sparklines. %>
<% tiles = [ [ "cpu", "CPU", :cpu ], [ "memory", "Memory", :memory ], [ "load", "Load", :load ], [ "disk", "Disk", :disk ] ] %>
<% pill = tag.span(class: "live__status", role: "status") do %>
  <span class="live__dot" aria-hidden="true"></span><span data-live-stats-target="status">Connecting…</span>
<% end %>

<div id="live_stats_<%= server.id %>" class="live" data-turbo-permanent data-state="connecting" data-live-stats-target="strip">
  <%= titled_section "Host", id: "section-host-live", actions: pill do %>
    <div class="live__tiles">
      <% tiles.each do |metric, label, icon_name| %>
        <div class="live__tile" role="group" aria-label="<%= metric == "load" ? "Load, 1 minute average" : label %>" data-metric="<%= metric %>">
          <div class="live__label">
            <span class="live__name"><%= icon icon_name %><%= label %><% if metric == "load" %> <span class="live__unit">1m</span><% end %></span>
            <span class="live__capacity" data-part="capacity"></span>
          </div>
          <div class="live__value" aria-live="off"><span data-part="value">—</span><span class="live__share" data-part="share"></span></div>
          <div class="live__range" aria-live="off" data-part="range">avg — · peak —</div>
          <svg class="live__spark" viewBox="0 0 120 32" preserveAspectRatio="none" aria-hidden="true">
            <line class="live__floor" x1="0" y1="31.5" x2="120" y2="31.5"/>
            <path class="live__area" data-part="area" d=""/>
            <path class="live__trace" data-part="trace" d=""/>
          </svg>
        </div>
      <% end %>
    </div>
    <p class="live__note txt-small txt-muted" data-live-stats-target="noHost" hidden>Host numbers need the agent's /proc mount.</p>
    <p class="live__note txt-small txt-muted" data-live-stats-target="noFrames" hidden>Nothing yet. The agent needs a version with live stats and a reachable /cable.</p>
  <% end %>
</div>
