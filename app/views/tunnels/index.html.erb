<% content_for :title, "Tunnels" %>
<% problems = @tunnels.count { it.state != :running } %>
<% summary = if @tunnels.none? then "No app runs behind a Cloudflare Tunnel yet."
             elsif problems.zero? then "#{pluralize(@tunnels.size, "app")} behind a Cloudflare Tunnel. Every connector is running."
             else "#{pluralize(@tunnels.size, "app")} behind a Cloudflare Tunnel. #{problems} #{problems == 1 ? "needs" : "need"} attention."
             end %>
<%= page_header "Tunnels", meta: summary do %>
  <%= link_to new_tunnel_path, class: "btn btn--primary" do %><%= icon :plus %> Set up a tunnel<% end %>
<% end %>

<% if @tunnels.none? %>
  <%= empty_state "No tunnels yet", icon_name: :tunnels do %>
    <p>A tunnel serves an app through Cloudflare, so its servers need no open ports. Meridian reads tunnels from Git and the agents and never calls Cloudflare.</p>
  <% end %>
<% else %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">App</th>
          <th scope="col">Hostnames</th>
          <th scope="col">Token</th>
          <th scope="col">Connectors</th>
          <th scope="col" class="table__end"><span class="sr-only">Steps</span></th>
        </tr>
      </thead>
      <tbody>
        <% @tunnels.each do |tunnel| %>
          <tr>
            <th scope="row"><%= link_to tunnel.app.name, tunnel.app %></th>
            <td class="mono txt-small nowrap"><%= safe_join(tunnel.app.hostnames, tag.br) %></td>
            <td>
              <% if tunnel.secret_name %>
                <span class="mono txt-small block nowrap"><%= tunnel.secret_name %></span>
                <%= tunnel.token_set? ? badge("set", tone: :ok, data: { tooltip: "Set from Meridian #{time_ago_in_words(tunnel.secret.last_set_at)} ago" }) : badge("not set here", data: { tooltip: "Meridian hasn't set this secret. It may be set on GitHub directly." }) %>
              <% else %>
                <span class="txt-faint">none</span>
              <% end %>
            </td>
            <td>
              <ul class="flex-col gap-s">
                <% tunnel.connectors.each do |connector| %>
                  <li class="flex items-center gap-s">
                    <%= case connector.state
                        when :running then badge("running", tone: :ok)
                        when :stopped then badge(connector.placement.state || "stopped", tone: :warn)
                        when :missing then badge("not started", tone: :bad)
                        else badge("unknown", data: { tooltip: "No agent is reporting from this server" })
                        end %>
                    <span class="mono txt-small nowrap"><%= connector.server ? link_to(connector.host, connector.server) : connector.host %></span>
                  </li>
                <% end %>
              </ul>
              <% if tunnel.missing? %>
                <p class="txt-small txt-muted">Start it with <%= copyable tunnel.boot_command %></p>
              <% end %>
            </td>
            <td class="table__end"><%= link_to "Steps", new_tunnel_path(app: tunnel.app.id), class: "btn btn--plain" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<div class="grid-2">
  <div class="card">
    <div class="card__header">Previews</div>
    <div class="card__body">
      <% if @account.preview_domain.blank? %>
        <p class="txt-muted">No preview domain is set, so previews have no hostname yet.</p>
      <% elsif @account.preview_hostnames_nested? %>
        <%= alert_box :warn, title: "Previews need flat hostnames behind a tunnel" do %>
          <p>They're named like <code><%= @account.preview_hostname("shop", 12) %></code>, two levels below the domain. Cloudflare's free certificate covers one.
          <% if current_user.admin? %><%= link_to "Switch to flat names", settings_account_path %>.<% else %>An admin can switch to flat names in Settings.<% end %></p>
        <% end %>
      <% else %>
        <p class="txt-muted">Previews are named like <code><%= @account.preview_hostname("shop", 12) %></code>, which Cloudflare's free certificate covers.</p>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card__header">Meridian itself</div>
    <div class="card__body">
      <p class="txt-muted">GitHub webhooks and agents must reach Meridian. To serve it through a tunnel, add the same connector to Meridian's own <code>config/deploy.yml</code> and set <code>proxy.ssl: false</code>. See <code>docs/cloudflare-tunnel.md</code>.</p>
    </div>
  </div>
</div>
