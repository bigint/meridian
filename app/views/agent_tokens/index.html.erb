<% content_for :title, "Agents" %>
<%= page_header "Agents" %>
<p class="txt-muted">Each server runs a small agent that reports its containers. Tokens let an agent report; revoke one to cut it off.</p>

<% if @token&.token %>
  <div class="alert alert--warn" role="status">
    <span class="alert__icon" aria-hidden="true">!</span>
    <div class="alert__body">
      <p class="alert__title">Copy this token now</p>
      <p>Meridian keeps only a digest and can't show it again.</p>
      <%= render "shared/code_block", code: @token.token, label: "MERIDIAN_TOKEN" %>
    </div>
  </div>
<% end %>

<div class="grid-2 grid-2--wide">
  <%= titled_section "Tokens", count: @tokens.size do %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Label</th>
            <th scope="col">Server</th>
            <th scope="col">Last used</th>
            <% if current_user.admin? %><th scope="col" class="table__end"></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% @tokens.each do |token| %>
            <tr>
              <th scope="row"><%= safe_join([ token.label, (badge("fleet") if token.fleet?) ].compact, " ") %></th>
              <td><%= token.server ? link_to(token.server.name, token.server) : tag.span(token.fleet? ? "many" : "binds on first contact", class: "txt-faint") %></td>
              <td class="nowrap"><%= token.revoked? ? badge("revoked", tone: :bad) : time_ago(token.last_used_at) %></td>
              <% if current_user.admin? %>
                <td class="table__end">
                  <% unless token.revoked? %>
                    <%= button_to "Revoke", agent_token_path(token), method: :delete, class: "btn btn--danger btn--small",
                          form: { data: { turbo_confirm: "Revoke “#{token.label}”? Agents using it stop reporting." } } %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
          <% if @tokens.none? %>
            <tr><td colspan="<%= current_user.admin? ? 4 : 3 %>" class="table__empty">No tokens yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if current_user.admin? %>
      <div class="card">
        <div class="card__header">New token</div>
        <div class="card__body">
          <%= form_with model: AgentToken.new, url: agent_tokens_path, class: "stack" do |form| %>
            <div class="field">
              <%= form.label :label %>
              <%= form.text_field :label, required: true, placeholder: "web-1" %>
              <%= field_errors(form.object, :label) %>
            </div>
            <label class="check">
              <%= form.check_box :fleet %>
              <span>Fleet token, shared by many servers <span class="block txt-small txt-muted">Identity comes from each machine id. One token per server is safer: revoking it affects only that server.</span></span>
            </label>
            <div><%= form.submit "Create token", class: "btn btn--primary" %></div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= titled_section "Install" do %>
    <p class="txt-muted">Add the agent to your Kamal config as an accessory on every host. It only makes outbound HTTPS requests and reads Docker through a proxy that allows listing and inspecting containers, nothing else.</p>
    <%= render "shared/code_block", code: render("agent_tokens/accessory", meridian_url: request.base_url), label: "config/deploy.yml" %>
    <p class="txt-small txt-muted">Put <code>MERIDIAN_TOKEN</code> in <code>.kamal/secrets</code>, then <code>kamal accessory boot meridian_agent</code> and <code>kamal accessory boot meridian_docker</code>. Details in <code>docs/agent.md</code>.</p>
  <% end %>
</div>

<%= titled_section "Silent agents", count: @silent.size do %>
  <p class="txt-small txt-muted">Agents that haven't reported for more than <%= distance_of_time_in_words(Server::STALE_AFTER) %>.</p>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Server</th>
          <th scope="col">Last seen</th>
          <th scope="col">Agent</th>
        </tr>
      </thead>
      <tbody>
        <% @silent.each do |server| %>
          <tr>
            <th scope="row"><%= link_to server.name, server %></th>
            <td><%= time_ago(server.last_seen_at) %></td>
            <td class="mono txt-small"><%= server.agent_version %></td>
          </tr>
        <% end %>
        <% if @silent.none? %>
          <tr><td colspan="3" class="table__empty">None.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @never.any? %>
    <p class="txt-small txt-muted">No agent has ever reported from <%= pluralize(@never.size, "server") %>: <%= safe_join(@never.first(20).map { link_to it.name, it }, ", ") %><%= "…" if @never.size > 20 %></p>
  <% end %>
<% end %>
