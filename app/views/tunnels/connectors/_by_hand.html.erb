<%# Stopping the dropped connectors and starting the new ones, by hand.
    locals: change, tunnel, direct (whether the change is a commit rather than a pull request) %>
<ol class="walk">
  <% if change.remove_commands.any? %>
    <%= render layout: "tunnels/step", locals: { number: 1, title: direct ? "Stop the dropped connectors" : "Before merging, stop the dropped connectors", done: false } do %>
      <p class="walk__text"><%= direct ? "Run this from a checkout from before the commit: Kamal no longer knows them after it." : "Once the pull request is merged, Kamal no longer knows them." %></p>
      <%= render "shared/code_block", code: change.remove_commands.join("\n"), label: "Terminal", language: "shell" %>
    <% end %>
  <% end %>
  <% if change.boot_commands.any? %>
    <%= render layout: "tunnels/step", locals: { number: change.remove_commands.any? ? 2 : 1, title: "After #{direct ? "the commit" : "merging"}, start the new ones", done: false } do %>
      <p class="walk__text">With <code><%= tunnel.secret_name %></code> in the environment. Each should register four connections, and Cloudflare lists it under its server's name.</p>
      <%= render "shared/code_block", code: change.boot_commands.join("\n"), label: "Terminal", language: "shell" %>
    <% end %>
  <% end %>
</ol>
