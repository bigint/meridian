<% content_for :title, "People" %>
<%= page_header "Settings", tabs: render("settings/nav") do %>
  <%= link_to new_settings_user_path, class: "btn btn--primary" do %><%= icon :plus %> Add person<% end %>
<% end %>

<p class="txt-muted">Viewers read everything. Deployers can also deploy and roll back. Admins do everything else.</p>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Email</th>
        <th scope="col">Role</th>
        <th scope="col">Sign-in</th>
        <th scope="col" class="table__end"></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <th scope="row"><%= safe_join([ avatar(user.display_name, small: true), user.display_name ], " ") %></th>
          <td><%= user.email_address %></td>
          <td><%= badge user.role, tone: (:accent if user.admin?) %></td>
          <td><%= user.identities.any? ? "Password, OIDC" : "Password" %></td>
          <td class="table__end"><%= link_to "Edit", edit_settings_user_path(user), class: "btn btn--plain btn--small" %></td>
        </tr>
      <% end %>
      <% if @users.none? %>
        <tr><td colspan="5" class="table__empty">Nothing here yet.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
