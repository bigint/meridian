<%= form_with model: project, class: "space-y-6" do |form| %>
  <%= render "shared/errors", record: project %>
  <%= render Ui::CardComponent.new do %>
    <div class="space-y-4">
      <%= form.field :name, required: true, autofocus: true %>
      <%= form.field :repo_full_name, label: "Repository", hint: "The GitHub repository that holds your Kamal configs, as owner/name.", required: true, placeholder: "acme/infra" %>
      <%= form.field :default_branch, label: "Branch", required: true %>
      <%= form.field :installation_id, label: "GitHub App installation ID", hint: "Shown in the URL after installing the Meridian GitHub App on this repository. Leave blank when Meridian uses a token." do %>
        <%= form.number_field :installation_id %>
      <% end %>
      <%= form.field :config_globs, label: "Config paths", value: project.config_globs.join(", "),
            hint: safe_join([ "Globs, comma separated. ", tag.code("config/deploy.staging.yml"), " is read as the ", tag.code("staging"), " destination of ", tag.code("config/deploy.yml"), "." ]) %>
      <label class="flex items-center gap-2 text-sm"><%= form.check_box :direct_commits %> Let admins commit changes directly instead of opening pull requests</label>
    </div>
  <% end %>
  <div class="flex gap-2">
    <%= form.submit %>
    <%= render Ui::ButtonComponent.new(label: "Cancel", href: project.persisted? ? project_path(project) : projects_path, variant: :ghost) %>
  </div>
<% end %>
