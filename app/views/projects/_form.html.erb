<%= form_with model: project, class: "stack-l" do |form| %>
  <%= render "shared/errors", record: project %>
  <div class="card">
    <div class="card__body">
      <div class="fields">
        <div class="field">
          <%= form.label :name %>
          <%= form.text_field :name, required: true, autofocus: true %>
          <%= field_errors(project, :name) %>
        </div>
        <div class="field">
          <%= form.label :repo_full_name, "Repository" %>
          <%= form.text_field :repo_full_name, required: true, placeholder: "acme/infra" %>
          <p class="field__hint">The GitHub repository that holds your Kamal configs, as owner/name.</p>
          <%= field_errors(project, :repo_full_name) %>
        </div>
        <div class="field">
          <%= form.label :default_branch, "Branch" %>
          <%= form.text_field :default_branch, required: true %>
          <%= field_errors(project, :default_branch) %>
        </div>
        <div class="field">
          <%= form.label :installation_id, "GitHub App installation ID" %>
          <%= form.number_field :installation_id %>
          <p class="field__hint">Shown in the URL after installing the Meridian GitHub App on this repository. Leave blank when Meridian uses a token.</p>
          <%= field_errors(project, :installation_id) %>
        </div>
        <div class="field">
          <%= form.label :config_globs, "Config paths" %>
          <%= form.text_field :config_globs, value: project.config_globs.join(", ") %>
          <p class="field__hint">Globs, comma separated. <code>config/deploy.staging.yml</code> is read as the <code>staging</code> destination of <code>config/deploy.yml</code>.</p>
          <%= field_errors(project, :config_globs) %>
        </div>
        <label class="check"><%= form.check_box :direct_commits %> <span>Let admins commit changes directly instead of opening pull requests</span></label>
      </div>
    </div>
  </div>
  <div class="flex gap-s">
    <%= form.submit class: "btn btn--primary" %>
    <%= link_to "Cancel", project.persisted? ? project_path(project) : projects_path, class: "btn btn--plain" %>
  </div>
<% end %>
