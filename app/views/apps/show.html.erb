<% content_for :title, @app.name %>
<% content_for :wide, true %>
<% content_for :head do %><%= turbo_refreshes_with method: :morph, scroll: :preserve %><% end %>
<% @board.stream_keys.each do |key| %><%= turbo_stream_from :board, key %><% end %>
<%= turbo_stream_from @app %>
<% group = @board.groups.first %>
<% cells = group ? group.columns.map { group.cell(@app, it) } : [] %>

<%= render Ui::PageHeaderComponent.new(title: @app.name) do |header| %>
  <% header.with_description do %>
    <div class="flex flex-wrap items-center gap-2">
      <%= render Ui::BadgeComponent.new(@app.kind) %>
      <span>in <%= link_to @app.project.name, @app.project, class: "text-accent hover:underline" %></span>
      <% @app.hostnames.each do |host| %><%= link_to host, "https://#{host}", class: "font-mono text-xs text-accent hover:underline" %><% end %>
    </div>
    <div class="mt-2"><%= render AppStatusComponent.new(app: @app, cells: cells) %></div>
  <% end %>
<% end %>

<div class="flex flex-wrap gap-5">
<div class="min-w-0 flex-[999_1_560px] space-y-5">
<%= render Ui::SectionComponent.new(title: "Servers", count: cells.size) do %>
  <%= render Ui::TableComponent.new(rows: cells, empty: "Not assigned to any server.") do |table| %>
    <% table.with_column("Running") { |cell| render VersionCellComponent.new(cell: cell) } %>
    <% table.with_column("Server", header: true) { |cell| link_to cell.server.name, cell.server, class: "font-mono text-xs hover:text-accent" } %>
    <% table.with_column("State") { |cell| render Ui::StateComponent.new(cell.state) } %>
    <% table.with_column("Roles") { |cell| cell.roles.join(", ") } %>
    <% table.with_column("Health") { |cell| cell.health == "unhealthy" ? render(Ui::BadgeComponent.new("unhealthy", tone: :bad)) : cell.health } %>
    <% table.with_column("Place", nowrap: true) { |cell| place(cell.server) } %>
  <% end %>
<% end %>

<%= render Ui::SectionComponent.new(title: "Releases", count: @releases.size) do %>
  <p class="text-xs text-ink-muted">From the Git history of <code><%= @app.release_source_path %></code>.</p>
  <% if @releases.any? %>
    <%= render Ui::ListComponent.new do |list| %>
      <% @releases.each_with_index do |release, index| %>
        <% list.with_item do |item| %>
          <% item.with_leading { render Ui::AvatarComponent.new(name: release.author.to_s, size: :sm) } %>
          <% item.with_subtitle do %><%= release.author %> · <%= link_to release.short_sha, "#{@app.project.repo_url}/commit/#{release.commit_sha}", class: "font-mono hover:text-accent" %><% end %>
          <% item.with_trailing do %>
            <%= time_ago(release.committed_at) %>
            <% if index.zero? && @releases.size > 1 && current_user.can_deploy? && @app.versioned? %>
              <%= render Ui::ButtonComponent.new(label: "Roll back", href: app_rollbacks_path(@app, release_id: release.id), method: :post, variant: :danger, size: :sm,
                    confirm: "Revert #{release.short_sha} so the version file goes back to its previous value? CI deploys the result.") %>
            <% end %>
          <% end %>
          <code class="font-semibold"><%= release.short_version %></code> <%= release.message %>
          <% if index.zero? %><%= render Ui::BadgeComponent.new("newest", tone: :accent) %><% end %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= render Ui::EmptyStateComponent.new(title: "No releases yet", icon: :activity) %>
  <% end %>
<% end %>

<%= render Ui::DisclosureComponent.new(summary: "Configuration") do %>
  <%= render Ui::DescriptionListComponent.new do |list| %>
    <% list.with_item("Config") do %><%= link_to @app.config_path, "#{@app.project.repo_url}/blob/#{@app.project.default_branch}/#{@app.config_path}", class: "font-mono text-accent hover:underline" %> <%= tag.code(@app.destination_flag) if @app.destination_flag %><% end %>
    <% list.with_item("Image") { tag.code(@app.image) } %>
    <% list.with_item("Roles") { @app.roles.map { "#{it["name"]} (#{pluralize(it["hosts"].size, "host")})" }.join(", ").presence || "–" } %>
    <% if @app.accessories.any? %><% list.with_item("Accessories") { @app.accessories.map { it["name"] }.join(", ") } %><% end %>
    <% list.with_item("Version file") { @app.version_path ? tag.code(@app.version_path) : tag.span("none yet: drift can't compare versions until one exists", class: "text-ink-muted") } %>
    <% list.with_item("Source") { @app.source_repo.presence || tag.span("not set: add the meridian.source label to get previews", class: "text-ink-muted") } %>
    <% list.with_item("Secrets") { @app.secret_names.join(", ").presence || "–" } %>
  <% end %>
<% end %>
</div>

<aside aria-label="Deploy" class="min-w-0 flex-[1_1_320px] lg:max-w-sm">
  <div class="space-y-5 rounded-lg border border-line bg-surface p-4 lg:sticky lg:top-16 lg:max-h-[calc(100svh-5rem)] lg:overflow-y-auto">
    <%= render "apps/deploys", app: @app %>
  </div>
</aside>
</div>
