<% content_for :title, "#{@draft.service} proposed" %>
<%= page_header "#{@draft.service} is #{proposal_state(@proposal)}",
      meta: "It appears on the board once #{@proposal.direct ? "the project syncs" : "the pull request is merged"}." do %>
  <%= proposal_link @proposal %>
<% end %>

<div class="grid-2">
  <div class="stack-l">
    <%= titled_section "Still to do by hand" do %>
      <ol class="list-numbered">
        <% @draft.manual_steps.each do |step| %><li><%= step %></li><% end %>
      </ol>
    <% end %>
    <%= titled_section "Files" do %>
      <% @draft.files.each do |path, content| %><%= render "shared/code_block", code: content, label: path %><% end %>
    <% end %>
  </div>
  <%= titled_section "Dockerfile for #{@draft.source_repo}" do %>
    <%= render "shared/code_block", code: @draft.instructions, label: "Instructions", language: "markdown" %>
  <% end %>
</div>
