<% content_for :title, @server.name %>
<% content_for :head do %><%= turbo_refreshes_with method: :morph, scroll: :preserve %><% end %>
<% @board.stream_keys.each do |key| %><%= turbo_stream_from :board, key %><% end %>
<% group = @board.groups.first %>

<%= render Ui::PageHeaderComponent.new(title: @server.name) do |header| %>
  <% header.with_description do %>
    <div class="flex flex-wrap items-center gap-2">
      <% if @server.stale? %><%= render Ui::StateComponent.new("stale") %> agent silent
      <% elsif !@server.reporting? %><%= render Ui::BadgeComponent.new("No agent yet") %>
      <% else %><%= render Ui::BadgeComponent.new("Reporting", tone: :ok) %><% end %>
      <%= labels_list(@server.labels) %>
    </div>
  <% end %>
<% end %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
  <%= render Ui::SectionComponent.new(title: "Machine") do %>
    <%= render Ui::CardComponent.new do %>
      <%= render Ui::DescriptionListComponent.new do |list| %>
        <% list.with_item("Hostname") { tag.code(@server.hostname) } %>
        <% list.with_item("Agent") { @server.agent_version || "not installed" } %>
        <% list.with_item("Last seen") { time_ago(@server.last_seen_at) } %>
        <% list.with_item("Location") { @server.located? ? "#{@server.latitude}, #{@server.longitude}" : tag.span("not set", class: "text-ink-faint") } %>
        <% list.with_item("Projects") { safe_join(@server.projects.map { link_to it.name, it, class: "text-accent hover:underline" }, ", ").presence || tag.span("none", class: "text-ink-faint") } %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Ui::SectionComponent.new(title: "Apps", count: group&.rows&.size || 0) do %>
    <%= render Ui::TableComponent.new(rows: group ? group.rows : [], empty: "Nothing assigned here.") do |table| %>
      <% table.with_column("App", header: true) { |app| link_to app.name, app, class: "hover:text-accent" } %>
      <% table.with_column("Roles") { |app| group.cell(app, @server).roles.join(", ") } %>
      <% table.with_column("State") { |app| render Ui::StateComponent.new(group.cell(app, @server).state) } %>
      <% table.with_column("Running", mono: true) { |app| group.cell(app, @server).versions.map { it.first(12) }.join(", ").presence || "–" } %>
    <% end %>
  <% end %>
</div>

<%= render Ui::SectionComponent.new(title: "Containers", count: @placements.size) do %>
  <p class="text-xs text-ink-muted">Everything with Kamal labels, as the agent last reported it.</p>
  <%= render Ui::TableComponent.new(rows: @placements, empty: "No containers reported.") do |table| %>
    <% table.with_column("Container", mono: true) { |placement| placement.name } %>
    <% table.with_column("Service") { |placement| safe_join([ (placement.app ? link_to(placement.service, placement.app, class: "hover:text-accent") : placement.service), (render(Ui::BadgeComponent.new(placement.kind)) unless placement.kind == "app") ].compact, " ") } %>
    <% table.with_column("Role") { |placement| placement.role } %>
    <% table.with_column("Version", mono: true) { |placement| placement.short_version } %>
    <% table.with_column("State") { |placement| placement.state } %>
    <% table.with_column("Health") { |placement| placement.health == "unhealthy" ? render(Ui::BadgeComponent.new("unhealthy", tone: :bad)) : placement.health } %>
    <% table.with_column("Started", nowrap: true) { |placement| time_ago(placement.started_at) } %>
  <% end %>
<% end %>

<% if current_user.admin? %>
  <%= render Ui::DisclosureComponent.new(summary: "Location on the map") do %>
    <%= form_with model: @server, class: "flex flex-wrap items-end gap-3" do |form| %>
      <div><%= form.label :latitude %><%= form.number_field :latitude, step: "any", min: -90, max: 90, compact: true %></div>
      <div><%= form.label :longitude %><%= form.number_field :longitude, step: "any", min: -180, max: 180, compact: true %></div>
      <%= form.submit "Save location", name: nil, variant: :secondary %>
    <% end %>
    <p class="mt-2 text-xs text-ink-muted">An agent that reports <code>lat</code> and <code>lng</code> labels overrides this on its next snapshot.</p>
  <% end %>
<% end %>
