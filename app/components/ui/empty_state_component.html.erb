<div class="flex flex-col items-center gap-2 rounded-lg border border-dashed border-line px-6 py-10 text-center">
  <% if @icon %><%= helpers.icon(@icon, class: "size-6 text-ink-faint") %><% end %>
  <p class="font-medium text-ink"><%= @title %></p>
  <% if content.present? %><div class="max-w-md text-ink-muted"><%= content %></div><% end %>
  <% if action? %><div class="mt-2"><%= action %></div><% end %>
</div>
