<div id="topbar" class="sticky top-0 z-30 flex h-12 items-center gap-3 border-b border-line bg-canvas/95 px-4 backdrop-blur lg:px-6">
  <button type="button" popovertarget="sidebar" class="rounded-md border border-line px-2.5 py-1 text-sm cursor-pointer lg:hidden">Menu</button>

  <div class="relative w-full max-w-sm" data-controller="jump">
    <%= form_with url: helpers.jump_path, method: :get, data: { turbo_frame: "jump_results", jump_target: "form" } do |form| %>
      <%= form.label :q, "Search apps, servers and projects", class: "sr-only" %>
      <div class="relative">
        <%= helpers.icon(:search, class: "pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-ink-faint") %>
        <%= form.search_field :q, placeholder: "Search apps, servers and projects", autocomplete: "off", compact: true, class: "!w-full pl-8",
              data: { jump_target: "input", action: "input->jump#search keydown->jump#key" } %>
      </div>
    <% end %>
    <turbo-frame id="jump_results" target="_top" class="absolute inset-x-0 top-full z-20 mt-1 empty:hidden"></turbo-frame>
  </div>

  <div class="ml-auto">
    <button type="button" popovertarget="account" aria-label="Account: <%= @user.display_name %>" class="flex items-center gap-2 rounded-md p-1 text-sm hover:bg-raised cursor-pointer">
      <%= render Ui::AvatarComponent.new(name: @user.display_name, size: :sm) %>
      <span class="hidden text-ink-muted sm:inline"><%= @user.display_name %></span>
    </button>
    <div id="account" popover class="fixed right-4 top-12 w-60 rounded-lg border border-line bg-canvas p-1">
      <div class="px-3 py-2">
        <p class="font-medium text-ink"><%= @user.display_name %></p>
        <p class="truncate text-xs text-ink-muted"><%= @user.email_address %> · <%= @user.role %></p>
      </div>
      <div class="border-t border-line pt-1">
        <%= button_to helpers.session_path, method: :delete, class: "flex w-full items-center gap-2 rounded-md px-3 py-1.5 text-left text-ink-muted hover:bg-raised hover:text-ink cursor-pointer" do %>
          <%= helpers.icon(:sign_out, class: "size-4") %> Sign out
        <% end %>
      </div>
    </div>
  </div>
</div>
