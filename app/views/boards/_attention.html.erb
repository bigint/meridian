<% items = board.attention %>
<section aria-labelledby="attention">
  <h2 id="attention" class="label">Needs attention</h2>

  <% if items.empty? %>
    <div class="empty">
      <span class="sparkle" aria-hidden="true">✨</span>
      <p><%= Project.exists? ? "Everything matches Git." : "Nothing to check yet." %></p>
    </div>
  <% else %>
    <ul class="rows">
      <% items.first(6).each do |item| %><%= render "boards/attention_item", item: item %><% end %>
    </ul>
    <% if items.size > 6 %>
      <details class="disclosure">
        <summary><%= pluralize(items.size - 6, "more thing") %></summary>
        <ul class="rows">
          <% items.drop(6).each do |item| %><%= render "boards/attention_item", item: item %><% end %>
        </ul>
      </details>
    <% end %>
  <% end %>
</section>
