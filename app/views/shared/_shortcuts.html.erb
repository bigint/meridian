<dialog data-shortcuts-target="help" aria-labelledby="shortcuts-title">
  <div class="stack">
    <h2 id="shortcuts-title">Keyboard shortcuts</h2>
    <dl class="facts">
      <dt><kbd>M</kbd> or <kbd>⌘K</kbd></dt><dd>Open the menu: type to go anywhere</dd>
      <dt><kbd>1</kbd>–<kbd>6</kbd></dt><dd>In the menu: Board, Apps, Servers, Activity, Previews, Agents</dd>
      <dt><kbd>g</kbd> <kbd>b</kbd></dt><dd>Board</dd>
      <dt><kbd>g</kbd> <kbd>a</kbd></dt><dd>Apps</dd>
      <dt><kbd>g</kbd> <kbd>s</kbd></dt><dd>Servers</dd>
      <dt><kbd>g</kbd> <kbd>e</kbd></dt><dd>Activity</dd>
      <dt><kbd>g</kbd> <kbd>v</kbd></dt><dd>Previews</dd>
      <dt><kbd>g</kbd> <kbd>g</kbd></dt><dd>Agents</dd>
      <dt><kbd>g</kbd> <kbd>k</kbd></dt><dd>Secrets</dd>
      <dt><kbd>g</kbd> <kbd>p</kbd></dt><dd>Projects</dd>
      <dt><kbd>/</kbd></dt><dd>Focus the filter on this page</dd>
      <dt><kbd>?</kbd></dt><dd>This help</dd>
    </dl>
    <form method="dialog"><button class="button">Close</button></form>
  </div>
</dialog>
