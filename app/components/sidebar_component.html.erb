<div class="flex h-full flex-col gap-4 p-3" data-controller="jump">
  <%= link_to helpers.root_path, class: "flex items-center gap-2 px-2 pt-1 font-semibold tracking-tight text-ink" do %>
    <%= helpers.icon(:logo, class: "size-5 text-accent") %> Meridian
  <% end %>

  <div class="relative">
    <%= form_with url: helpers.jump_path, method: :get, data: { turbo_frame: "jump_results", jump_target: "form" } do |form| %>
      <%= form.label :q, "Search apps, servers and projects", class: "sr-only" %>
      <%= form.search_field :q, placeholder: "Search…", autocomplete: "off", compact: true, class: "!w-full",
            data: { jump_target: "input", action: "input->jump#search keydown->jump#key" } %>
    <% end %>
    <turbo-frame id="jump_results" target="_top" class="absolute inset-x-0 top-full z-20 mt-1 empty:hidden"></turbo-frame>
  </div>

  <nav aria-label="Main" class="flex flex-col gap-0.5">
    <% primary.each do |name, path, icon, badge| %><%= nav_link(name, path, icon, badge) %><% end %>
  </nav>

  <nav aria-label="More" class="flex flex-col gap-0.5">
    <p class="px-2 pb-1 text-[11px] font-semibold uppercase tracking-wider text-ink-faint">Manage</p>
    <% secondary.each do |name, path, icon| %><%= nav_link(name, path, icon) %><% end %>
  </nav>

  <div class="mt-auto flex items-center gap-2.5 rounded-md border border-line p-2">
    <%= render Ui::AvatarComponent.new(name: @user.display_name) %>
    <div class="min-w-0 flex-1">
      <p class="truncate text-sm font-medium text-ink"><%= @user.display_name %></p>
      <p class="truncate text-xs text-ink-muted"><%= @user.role.capitalize %></p>
    </div>
    <%= button_to helpers.session_path, method: :delete, class: "rounded-md p-1.5 text-ink-faint hover:bg-raised hover:text-ink cursor-pointer", title: "Sign out", aria: { label: "Sign out" } do %>
      <%= helpers.icon(:sign_out, class: "size-4") %>
    <% end %>
  </div>
</div>
