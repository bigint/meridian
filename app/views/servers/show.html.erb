<% content_for :title, @server.name %>
<% content_for :wide, true %>
<% content_for :head do %><%= turbo_refreshes_with method: :morph, scroll: :preserve %><% end %>
<% @board.stream_keys.each do |key| %><%= turbo_stream_from :board, key %><% end %>
<% group = @board.groups.first %>

<% status = capture do %>
  <% if @server.stale? %><%= state_badge "stale" %> agent silent
  <% elsif !@server.reporting? %><%= badge "No agent yet" %>
  <% else %><%= badge "Reporting", tone: :ok %><% end %>
  <%= place(@server) %>
<% end %>
<%= page_header @server.name, meta: status %>

<div class="split">
  <div class="split__main">
    <%= titled_section "Apps", count: group&.rows&.size || 0 do %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Running</th>
              <th scope="col">App</th>
              <th scope="col">State</th>
              <th scope="col">Roles</th>
            </tr>
          </thead>
          <tbody>
            <% rows = group ? group.rows : [] %>
            <% rows.each do |app| %>
              <% cell = group.cell(app, @server) %>
              <tr>
                <td><%= version_cell cell %></td>
                <th scope="row"><%= link_to app.name, app %></th>
                <td><%= state_badge cell.state %></td>
                <td><%= cell.roles.join(", ") %></td>
              </tr>
            <% end %>
            <% if rows.none? %>
              <tr><td colspan="4" class="table__empty">Nothing assigned here.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <%= titled_section "Containers", count: @placements.size do %>
      <p class="txt-small txt-muted">Everything with Kamal labels, as the agent last reported it.</p>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Container</th>
              <th scope="col">Service</th>
              <th scope="col">Role</th>
              <th scope="col">Version</th>
              <th scope="col">State</th>
              <th scope="col">Health</th>
              <th scope="col">Started</th>
            </tr>
          </thead>
          <tbody>
            <% @placements.each do |placement| %>
              <tr>
                <td class="mono txt-small"><%= placement.name %></td>
                <td><%= safe_join([ (placement.app ? link_to(placement.service, placement.app) : placement.service), (badge(placement.kind) unless placement.kind == "app") ].compact, " ") %></td>
                <td><%= placement.role %></td>
                <td class="mono txt-small"><%= placement.short_version %></td>
                <td><%= placement.state %></td>
                <td><%= placement.health == "unhealthy" ? badge("unhealthy", tone: :bad) : placement.health %></td>
                <td class="nowrap"><%= time_ago(placement.started_at) %></td>
              </tr>
            <% end %>
            <% if @placements.none? %>
              <tr><td colspan="7" class="table__empty">No containers reported.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <aside class="split__aside" aria-label="Machine">
    <div class="panel">
      <%= titled_section "Machine" do %>
        <div class="card">
          <div class="card__body">
            <dl class="facts">
              <dt>Hostname</dt>
              <dd><code><%= @server.hostname %></code></dd>
              <dt>Agent</dt>
              <dd><%= @server.agent_version || "not installed" %></dd>
              <dt>Last seen</dt>
              <dd><%= time_ago(@server.last_seen_at) %></dd>
              <dt>Location</dt>
              <dd><%= @server.located? ? "#{@server.latitude}, #{@server.longitude}" : tag.span("not set", class: "txt-faint") %></dd>
              <dt>Projects</dt>
              <dd><%= safe_join(@server.projects.map { link_to it.name, it }, ", ").presence || tag.span("none", class: "txt-faint") %></dd>
            </dl>
          </div>
        </div>
      <% end %>

      <% if @server.labels.except(*ApplicationHelper::PLACE_LABELS).any? %>
        <%= titled_section "Labels" do %>
          <div class="flex flex-wrap gap-xs"><%= labels_list(@server.labels, except: ApplicationHelper::PLACE_LABELS) %></div>
        <% end %>
      <% end %>

      <% if current_user.admin? %>
        <%= titled_section "Location on the map" do %>
          <%= form_with model: @server, class: "filters" do |form| %>
            <div class="field"><%= form.label :latitude %><%= form.number_field :latitude, step: "any", min: -90, max: 90 %></div>
            <div class="field"><%= form.label :longitude %><%= form.number_field :longitude, step: "any", min: -180, max: 180 %></div>
            <%= form.submit "Save location", name: nil, class: "btn" %>
          <% end %>
          <p class="txt-small txt-muted">An agent that reports <code>lat</code> and <code>lng</code> labels overrides this on its next snapshot.</p>
        <% end %>
      <% end %>
    </div>
  </aside>
</div>
