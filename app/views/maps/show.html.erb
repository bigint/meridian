<% content_for :title, "Map" %>
<% content_for :wide, true %>
<% content_for :head do %><%= turbo_refreshes_with method: :morph, scroll: :preserve %><% end %>
<% @map.stream_keys.each do |key| %><%= turbo_stream_from :board, key %><% end %>
<% sites = @map.sites %>
<% services = App.deployable.distinct.order(:service).pluck(:service) %>
<% problems = sites.group_by(&:state).slice(*Drift::ATTENTION_RANK.keys) %>
<% deploying = sites.count { @map.deploying?(it) } %>

<%= page_header "Map", meta: "#{pluralize(sites.sum { it.servers.size }, "server")} in #{pluralize(sites.size, "place")}#{" · Meridian runs in #{@map.hub_name}" if @map.hub}" %>

<div class="chips">
  <% if services.size.between?(2, 8) %>
    <span class="chips__label">App</span>
    <%= chip "All", services.size, current: @map.filters[:service].blank?, href: map_path(request.query_parameters.except("service", "place")) %>
    <% services.each do |service| %>
      <%= chip service, App.deployable.where(service: service).count, current: @map.filters[:service] == service,
            href: map_path(request.query_parameters.except("place").merge(service: (@map.filters[:service] == service ? nil : service))) %>
    <% end %>
    <span class="chips__rule" aria-hidden="true"></span>
  <% end %>
  <% if problems.any? || deploying.positive? %><span class="chips__label">Places</span><% end %>
  <% problems.each do |state, list| %><%= chip Drift::LABELS[state], list.size, state: state %><% end %>
  <% if deploying.positive? %><%= chip "Deploying", deploying, symbol: "↗", tone: "txt-info" %><% end %>
  <% if problems.empty? && deploying.zero? && sites.any? %><%= chip "Every place matches Git", nil, symbol: "✓", tone: "txt-ok" %><% end %>
</div>

<%= disclosure "Filters", open: @map.filters.except(:app, :service).any? do %>
  <%= form_with url: map_path, method: :get, class: "filters" do |form| %>
    <%= form.hidden_field :service, value: @map.filters[:service] if @map.filters[:service] %>
    <div class="field"><%= form.label :app %><%= form.search_field :app, value: @map.filters[:app], placeholder: "Service" %></div>
    <div class="field"><%= form.label :project %><%= form.select :project, @projects.map { [ it.name, it.id ] }, { include_blank: "All", selected: @map.filters[:project] } %></div>
    <% Board::LABELS.each do |key| %>
      <div class="field"><%= form.label key %><%= form.select key, Board.new.label_values(key), { include_blank: "All", selected: @map.filters[key.to_sym] } %></div>
    <% end %>
    <%= form.submit "Apply", name: nil, class: "btn" %>
    <% if @map.filters.any? %><%= link_to "Clear", map_path, class: "btn btn--plain" %><% end %>
  <% end %>
<% end %>

<div class="split">
  <div class="split__main">
    <%= render "maps/world", map: @map, selected: @selected %>

    <% unless @map.hub %>
      <%= alert_box do %><p>
        <% if current_user.admin? %><%= link_to "Set where Meridian runs", settings_account_path %><% else %>An admin can set where Meridian runs<% end %>
        to see agent reports and deploys flowing on the map.
      </p><% end %>
    <% end %>

    <%= titled_section "Places", count: sites.size do %>
      <% rows = sites.sort_by { [ Drift::ATTENTION_RANK.fetch(it.state, 9), @map.deploying?(it) ? 0 : 1, it.name ] } %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th scope="col">Place</th><th scope="col">Region</th><th scope="col">Running</th><th scope="col">Agents</th></tr></thead>
          <tbody>
            <% rows.each do |site| %>
              <tr>
                <th scope="row"><%= link_to site.name, map_place_path(site), class: (site == @selected ? "txt-accent txt-strong" : nil), aria: { current: (site == @selected ? "true" : nil) } %></th>
                <td class="mono txt-small nowrap"><%= site.servers.filter_map { it.label("region") }.uniq.join(", ").presence || "–" %></td>
                <td><div class="cells"><% site.cells.sort_by { [ it.app.name, it.server.name ] }.each do |cell| %><%= version_cell cell %><% end %></div></td>
                <td class="nowrap"><%= site.stale? ? badge("… quiet") : "reporting" %></td>
              </tr>
            <% end %>
            <% if rows.none? %><tr><td colspan="4" class="table__empty">No server has a location yet.</td></tr><% end %>
          </tbody>
        </table>
      </div>
      <% if (unlocated = @map.unlocated).any? %>
        <p class="txt-small txt-muted"><%= pluralize(unlocated.size, "server") %> without a location (<%= unlocated.first(5).map(&:short_name).join(", ") %><%= "…" if unlocated.size > 5 %>). Add <code>lat=…,lng=…</code> to <code>MERIDIAN_LABELS</code> on their agent, or set it on the server page.</p>
      <% end %>
    <% end %>
  </div>

  <aside class="split__aside" aria-label="Selected place">
    <div id="place" class="panel">
      <% if @selected %>
        <%= render "maps/place", map: @map, site: @selected %>
      <% else %>
        <p class="txt-muted">No server has a location yet. Agents report one with <code>lat</code> and <code>lng</code> labels, or set it on a server's page.</p>
      <% end %>
    </div>
  </aside>
</div>
