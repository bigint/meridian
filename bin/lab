#!/usr/bin/env bash
# A local fleet for Meridian: Docker-in-Docker servers, a registry and a
# GitHub Actions runner, running real bigint sites. See lab/README.md.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LAB="$ROOT/lab"
SECRETS="$LAB/.secrets"
SERVERS=(apse1-az1-node-01 euc1-az1-node-01 use1-az1-node-01 apne1-az1-node-01 apne2-az1-node-01 usw1-az1-node-01 aps2-az1-node-01 euc1-az2-node-01 euw2-az1-node-01 euw3-az1-node-01 eun1-az1-node-01 eus2-az1-node-01 apse2-az1-node-01 apse4-az1-node-01 apse2-per1-node-01 mec1-az1-node-01 aps2-az1-node-02 aps2-az2-node-01 aps2-az3-node-01 sae1-az1-node-01 afs1-az1-node-01)
# Named like AWS availability zones; the locations are pretend, for the map.
place() {
  case "$1" in
    apse1-az1-node-01) echo "region=ap-southeast-1,city=Singapore,lat=1.35,lng=103.82" ;;
    euc1-az1-node-01) echo "region=eu-central-1,city=Frankfurt,lat=50.11,lng=8.68" ;;
    use1-az1-node-01) echo "region=us-east-1,city=New York,lat=40.71,lng=-74.01" ;;
    apne1-az1-node-01) echo "region=ap-northeast-1,city=Tokyo,lat=35.68,lng=139.69" ;;
    apne2-az1-node-01) echo "region=ap-northeast-2,city=Seoul,lat=37.57,lng=126.98" ;;
    usw1-az1-node-01) echo "region=us-west-1,city=San Francisco,lat=37.77,lng=-122.42" ;;
    aps2-az1-node-01) echo "region=ap-south-2,city=Bangalore,lat=12.97,lng=77.59" ;;
    euc1-az2-node-01) echo "region=eu-central-1,city=Amsterdam,lat=52.37,lng=4.9" ;;
    euw2-az1-node-01) echo "region=eu-west-2,city=London,lat=51.51,lng=-0.13" ;;
    euw3-az1-node-01) echo "region=eu-west-3,city=Paris,lat=48.86,lng=2.35" ;;
    eun1-az1-node-01) echo "region=eu-north-1,city=Stockholm,lat=59.33,lng=18.07" ;;
    eus2-az1-node-01) echo "region=eu-south-2,city=Madrid,lat=40.42,lng=-3.7" ;;
    apse2-az1-node-01) echo "region=ap-southeast-2,city=Sydney,lat=-33.87,lng=151.21" ;;
    apse4-az1-node-01) echo "region=ap-southeast-4,city=Melbourne,lat=-37.81,lng=144.96" ;;
    apse2-per1-node-01) echo "region=ap-southeast-2,city=Perth,lat=-31.95,lng=115.86" ;;
    mec1-az1-node-01) echo "region=me-central-1,city=Dubai,lat=25.2,lng=55.27" ;;
    aps2-az1-node-02) echo "region=ap-south-2,city=Bangalore,lat=12.98,lng=77.6" ;;
    aps2-az2-node-01) echo "region=ap-south-2,city=Bangalore,lat=12.96,lng=77.58" ;;
    aps2-az3-node-01) echo "region=ap-south-2,city=Bangalore,lat=12.97,lng=77.61" ;;
    sae1-az1-node-01) echo "region=sa-east-1,city=São Paulo,lat=-23.55,lng=-46.63" ;;
    afs1-az1-node-01) echo "region=af-south-1,city=Cape Town,lat=-33.92,lng=18.42" ;;
  esac
}
# The real sites: files-only images at ghcr.io/bigint/<site>, one tag per commit.
SITES=(yoginth-com asiafibernet-com nailbykyro-com asiagigafibernet-com occasions pckumar-in)
compose() { docker compose -f "$LAB/compose.yml" "$@"; }

# A site's published versions (full commit SHAs), oldest first, as GHCR lists them.
versions() {
  local token
  token="$(curl -fsS "https://ghcr.io/token?scope=repository:bigint/$1:pull" | jq -r .token)"
  curl -fsS -H "Authorization: Bearer $token" "https://ghcr.io/v2/bigint/$1/tags/list?n=1000" \
    | jq -r '.tags[] | select(test("^[0-9a-f]{40}$"))'
}

# Wraps ghcr.io/bigint/SITE at VERSION (a SHA prefix; the newest if empty) in
# lab/site and pushes it as localhost:5555/bigint/SITE:<7-character SHA>.
push_site() {
  local site="$1" want="${2:-}" sha
  sha="$(versions "$site" | grep "^$want" | tail -n 1 || true)"
  [ -n "$sha" ] || { echo "$site: no version ${want:-at all} on ghcr.io/bigint/$site" >&2; return 1; }
  docker build -q --build-arg SITE="$site" --build-arg SITE_IMAGE="ghcr.io/bigint/$site:$sha" \
    -t "localhost:5555/bigint/$site:${sha:0:7}" "$LAB/site" >/dev/null
  docker push -q "localhost:5555/bigint/$site:${sha:0:7}" >/dev/null
  echo "$site: pushed ${sha:0:7}"
}

ensure_secrets() {
  mkdir -p "$SECRETS" && chmod 700 "$SECRETS"
  [ -f "$SECRETS/id_ed25519" ] || ssh-keygen -q -t ed25519 -N "" -C meridian-lab -f "$SECRETS/id_ed25519"
  cp "$SECRETS/id_ed25519.pub" "$SECRETS/authorized_keys"
  [ -f "$SECRETS/registry_password" ] || (openssl rand -hex 16 > "$SECRETS/registry_password")
  [ -s "$SECRETS/webhook_secret" ] || (openssl rand -hex 32 > "$SECRETS/webhook_secret")
  [ -s "$SECRETS/htpasswd" ] || docker run --rm httpd:2.4-alpine htpasswd -Bbn lab "$(cat "$SECRETS/registry_password")" > "$SECRETS/htpasswd"
}

registry_login() {
  docker login localhost:5555 -u lab --password-stdin < "$SECRETS/registry_password" >/dev/null
}

case "${1:-}" in
  up)
    repo="${2:?usage: bin/lab up owner/infra-repo}"
    ensure_secrets
    compose up -d --build registry "${SERVERS[@]}"
    echo "Registering the runner on $repo…"
    token="$(gh api -X POST "repos/$repo/actions/runners/registration-token" --jq .token)"
    RUNNER_REPO="$repo" RUNNER_TOKEN="$token" compose --profile runner up -d --build runner
    echo "Lab is up. Registry password: lab/.secrets/registry_password. SSH key: lab/.secrets/id_ed25519."
    ;;

  push)
    site="${2:?usage: bin/lab push SITE|all [VERSION]}"
    registry_login
    if [ "$site" = all ]; then
      for site in "${SITES[@]}"; do push_site "$site"; done
    else
      push_site "$site" "${3:-}"
    fi
    ;;

  versions)
    site="${2:?usage: bin/lab versions SITE}"
    versions "$site" | cut -c1-7
    ;;

  agents)
    url="${MERIDIAN_URL:-http://host.docker.internal:3000}"
    registry_login
    docker build -q --build-arg VERSION=lab -t localhost:5555/meridian-agent:lab "$ROOT/agent" >/dev/null
    docker push -q localhost:5555/meridian-agent:lab >/dev/null
    for server in "${SERVERS[@]}"; do
      token="$(cd "$ROOT" && bin/rails runner "print AgentToken.where(label: '$server', revoked_at: nil).destroy_all && AgentToken.create!(label: '$server').token" 2>/dev/null)"
      docker exec -i "meridian-lab-$server-1" sh -c '
        docker login registry:5000 -u lab --password-stdin >/dev/null &&
        docker rm -f meridian-agent >/dev/null 2>&1;
        host_ip="$(getent hosts host.docker.internal | cut -d" " -f1)";
        docker run -d --pull always --name meridian-agent --restart unless-stopped --user 0 \
          ${host_ip:+--add-host host.docker.internal:$host_ip} \
          -v /var/run/docker.sock:/var/run/docker.sock:ro \
          -v /etc/machine-id:/host/etc/machine-id:ro -v /etc/hostname:/host/etc/hostname:ro -v /proc:/host/proc:ro \
          -e MERIDIAN_URL='"$url"' -e MERIDIAN_TOKEN='"$token"' -e MERIDIAN_INTERVAL=5s \
          -e "MERIDIAN_LABELS=provider=kiri,'"$(place "$server")"'" \
          registry:5000/meridian-agent:lab >/dev/null' < "$SECRETS/registry_password"
      echo "$server: agent running"
    done
    ;;

  webhooks)
    # GitHub forwards the repository's webhooks to the dev server, which stays
    # private. Runs until stopped; GitHub allows one such forward per repository.
    repo="${2:?usage: bin/lab webhooks owner/infra-repo}"
    ensure_secrets
    exec gh webhook forward --repo="$repo" --events=push,workflow_run,pull_request \
      --url="${MERIDIAN_URL:-http://localhost:3000}/webhooks/github" --secret="$(cat "$SECRETS/webhook_secret")"
    ;;

  ssh)
    server="${2:-apse1-az1-node-01}"
    docker exec -it "meridian-lab-$server-1" sh
    ;;

  status)
    compose --profile runner ps --format 'table {{.Service}}\t{{.Status}}'
    for server in "${SERVERS[@]}"; do
      echo "— $server"
      docker exec "meridian-lab-$server-1" docker ps --format '  {{.Names}}  {{.Image}}  {{.Status}}' 2>/dev/null || echo "  (down)"
    done
    ;;

  down)
    compose --profile runner down
    ;;

  *)
    echo "usage: bin/lab up owner/repo | push SITE|all [VERSION] | versions SITE | agents | webhooks owner/repo | ssh [server] | status | down" >&2
    exit 1
    ;;
esac
