<%= render Ui::DisclosureComponent.new(summary: "Filters", open: board.filters.except(:view, :page, :state).any?) do %>
  <%= form_with url: board_path(anchor: "everything"), method: :get, class: "flex flex-wrap items-end gap-3", data: { turbo_action: "replace" } do |form| %>
    <%= form.hidden_field :view, value: board.view %>
    <%= form.hidden_field :state, value: board.state if board.state %>
    <div><%= form.label :app %><%= form.search_field :app, value: board.filters[:app], placeholder: "Service", compact: true %></div>
    <div><%= form.label :project %><%= form.select :project, projects.map { [ it.name, it.id ] }, { include_blank: "All", selected: board.filters[:project] }, compact: true %></div>
    <% Board::LABELS.each do |key| %>
      <div><%= form.label key %><%= form.select key, board.label_values(key), { include_blank: "All", selected: board.filters[key.to_sym] }, compact: true %></div>
    <% end %>
    <div><%= form.label :group, "Group by" %><%= form.select :group, [ [ "Automatic", "" ], [ "Nothing", "none" ], *Board::LABELS.map { [ it.capitalize, it ] } ], { selected: board.filters[:group] }, compact: true %></div>
    <%= form.submit "Apply", name: nil, variant: :secondary %>
    <% if board.filters.except(:view).any? %><%= render Ui::ButtonComponent.new(label: "Clear", href: board_path(view: board.view, anchor: "everything"), variant: :ghost) %><% end %>
  <% end %>
<% end %>
