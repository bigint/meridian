<%# A record's errors above its form. locals: record, title (optional) %>
<% if record.errors.any? %>
  <%= alert_box :bad, title: local_assigns[:title] || "Please fix #{pluralize(record.errors.count, "problem")}" do %>
    <ul><% record.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  <% end %>
<% end %>
