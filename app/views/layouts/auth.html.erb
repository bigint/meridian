<!DOCTYPE html>
<html lang="en" <%= tag.attributes(data: { theme: theme }) %>>
  <head>
    <title><%= [ content_for(:title), "Meridian" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="auth">
    <main class="auth__column">
      <%= link_to root_path, class: "auth__brand" do %><%= icon :logo, class: "txt-accent", width: 24, height: 24 %> Meridian<% end %>
      <div class="auth__card">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
