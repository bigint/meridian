<% content_for :title, "Secrets" %>
<%= page_header "Secrets" %>
<p class="txt-muted">Names come from <code>env.secret</code> and <code>registry.password</code> in your Kamal configs. Values go straight to each repository's encrypted Actions secrets; Meridian never stores, logs or shows them.</p>

<% @projects.each do |project| %>
  <%= titled_section project.name, count: project.secret_names.size, id: "project-#{project.id}",
        actions: tag.span(project.repo_full_name, class: "mono txt-small txt-muted") do %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Used by</th>
            <th scope="col">Last set</th>
            <th scope="col">Set or rotate</th>
          </tr>
        </thead>
        <tbody>
          <% project.secret_names.sort_by(&:name).each do |secret| %>
            <tr>
              <th scope="row"><code><%= secret.name %></code></th>
              <td><%= secret.referenced? ? secret.apps.join(", ") : tag.span("not referenced by any config", class: "txt-faint") %></td>
              <td><%= secret.last_set_at ? safe_join([ time_ago(secret.last_set_at), " by ", secret.last_set_by&.display_name || "a removed user" ]) : tag.span("not set through Meridian", class: "txt-faint") %></td>
              <td>
                <%= form_with url: secret_path(secret), method: :patch, class: "filters" do |form| %>
                  <%= form.label :secret_value, "Value for #{secret.name}", class: "sr-only", for: "value-#{secret.id}" %>
                  <%= form.password_field :secret_value, id: "value-#{secret.id}", required: true, autocomplete: "off", value: nil %>
                  <%= form.submit secret.last_set_at ? "Rotate" : "Set", class: "btn" %>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if project.secret_names.none? %>
            <tr><td colspan="4" class="table__empty">No configs reference secrets.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= disclosure "Add another name" do %>
      <%= form_with model: SecretName.new, url: secrets_path(project_id: project.id), class: "filters" do |form| %>
        <div class="field">
          <%= form.label :name %>
          <%= form.text_field :name, required: true, placeholder: "DATABASE_URL", pattern: "[A-Za-z_][A-Za-z0-9_]*" %>
        </div>
        <div class="field">
          <label for="secret_value_<%= project.id %>">Value (optional)</label>
          <%= password_field_tag :secret_value, nil, id: "secret_value_#{project.id}", autocomplete: "off" %>
        </div>
        <%= form.submit "Add", class: "btn" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
