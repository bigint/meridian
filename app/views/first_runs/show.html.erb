<% content_for :title, "Welcome" %>
<div class="flex-col gap-xs">
  <h1 class="page-header__title">Welcome to Meridian</h1>
  <p class="txt-muted">Create your account. Meridian has one user: you.</p>
</div>

<%= form_with model: @user, url: first_run_path, class: "fields" do |form| %>
  <%= render "shared/errors", record: @user %>
  <div class="field">
    <%= label_tag :setup_code, "Setup code" %>
    <%= text_field_tag :setup_code, (User.setup_code if Rails.env.development?), required: true, autocomplete: "off", spellcheck: false, class: "mono" %>
    <p class="field__hint">Proves you have access to the server. Find it in Meridian's log (<code>kamal app logs | grep "setup code"</code>), or run <code>bin/rails meridian:setup_code</code> on the server.</p>
    <%= field_errors(@user, :setup_code) %>
  </div>
  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, autofocus: true %>
    <%= field_errors(@user, :name) %>
  </div>
  <div class="field">
    <%= form.label :email_address, "Email" %>
    <%= form.email_field :email_address, required: true, autocomplete: "username" %>
    <%= field_errors(@user, :email_address) %>
  </div>
  <div class="field">
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72 %>
    <p class="field__hint">At least 12 characters.</p>
    <%= field_errors(@user, :password) %>
  </div>
  <%= form.submit "Create account", class: "btn btn--primary btn--block" %>
<% end %>
