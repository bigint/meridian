<%# The board's side panel: one app at a glance, and what you can do to it. %>
<% cells = app_cells(app) %>
<% releases = app.releases.limit(3).to_a %>
<div class="stack-l" data-inspector>
  <div class="flex-col gap-s">
    <p class="panel__kicker">APP</p>
    <h2 class="panel__title"><%= link_to app.name, app %></h2>
    <div class="flex flex-wrap items-center gap-s txt-muted"><%= badge app.kind %><span>in <%= app.project.name %></span></div>
    <div><%= app_status app, cells %></div>
  </div>

  <% if current_user.can_deploy? %>
    <%= form_with url: app_deploys_path(app), scope: :deploy, class: "card card--compact" do |form| %>
      <div class="card__body">
        <%= form.label :version, "Ship a version", for: "inspector-version", class: "txt-strong" %>
        <div class="flex gap-s">
          <%= form.text_field :version, id: "inspector-version", class: "mono", required: true, pattern: App::VERSION_PATTERN, autocomplete: "off", placeholder: app.latest_release&.version %>
          <%= form.submit "Deploy", class: "btn btn--primary", data: { turbo_confirm: "Commit this version to #{app.version_file_path}?" } %>
        </div>
        <p class="field__hint">Commits the tag to <code><%= app.version_file_path %></code>; CI runs <code>kamal deploy</code>.</p>
      </div>
    <% end %>
  <% end %>

  <%= titled_section "Servers", count: cells.size, id: "inspector-servers" do %>
    <% if cells.any? %>
      <ul class="rows">
        <% cells.each do |cell| %>
          <li class="row">
            <%= version_cell cell %>
            <%= link_to cell.server.name, cell.server, class: "mono txt-small truncate" %>
            <span class="ml-auto txt-small txt-muted"><%= cell.server.label("city") || cell.server.label("region") %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="txt-muted">Not assigned to any server.</p>
    <% end %>
  <% end %>

  <%= titled_section "Recent releases", id: "inspector-releases" do %>
    <% if releases.any? %>
      <ol class="stack">
        <% releases.each do |release| %>
          <li class="flex items-baseline gap">
            <code class="txt-strong shrink-0"><%= release.short_version %></code>
            <span class="min-w-0">
              <span class="block truncate"><%= release.message %></span>
              <span class="txt-small txt-muted"><%= release.author %> · <code><%= release.short_sha %></code> · <%= time_ago(release.committed_at) %></span>
            </span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="txt-muted">No releases yet.</p>
    <% end %>
  <% end %>

  <div class="flex flex-wrap gap-s">
    <% if current_user.can_deploy? && app.versioned? && app.latest_release %>
      <%= button_to "Redeploy", app_redeploy_path(app), class: "btn btn--small",
            form: { data: { turbo_confirm: "Run the deploy workflow again for the version in #{app.version_file_path}? Use this after rotating a secret." } } %>
    <% end %>
    <% if current_user.can_deploy? && app.versioned? && releases.size > 1 %>
      <%= button_to "Roll back", app_rollbacks_path(app, release_id: releases.first.id), class: "btn btn--small btn--danger",
            form: { data: { turbo_confirm: "Revert #{releases.first.short_sha} so the version file goes back to its previous value? CI deploys the result." } } %>
    <% end %>
    <%= link_to "Open app page", app, class: "btn btn--small btn--plain" %>
  </div>
</div>
