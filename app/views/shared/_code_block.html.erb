<div class="code-block" data-controller="clipboard">
  <div class="code-block__bar">
    <span><%= label %></span>
    <button type="button" class="code-block__copy" data-action="clipboard#copy" data-clipboard-target="button">Copy</button>
  </div>
  <pre><code data-clipboard-target="source"><%= code %></code></pre>
</div>
