<div id="jump" popover class="jump" data-controller="jump" data-action="toggle->jump#toggled keydown->jump#key" aria-label="Go to">

  <%= form_with url: jump_path, method: :get, data: { turbo_frame: "jump_results", jump_target: "form" } do |form| %>
    <%= form.label :q, "Go to an app, server or project", class: "visually-hidden" %>
    <%= form.search_field :q, placeholder: "Type to go to an app, server or project…", autocomplete: "off",
          data: { jump_target: "input", action: "input->jump#search" } %>
  <% end %>
  <turbo-frame id="jump_results" class="jump__results" target="_top"></turbo-frame>

  <nav aria-label="Places">
    <div class="jump__tiles">
      <% jump_places.each do |name, path, icon_name| %>
        <%= link_to path, aria: { current: (current_place?(path) ? "page" : nil) } do %>
          <%= icon icon_name %><%= name %>
        <% end %>
      <% end %>
    </div>

    <p class="label">More</p>
    <ul class="jump__list">
      <% jump_more.each do |name, path, icon_name| %>
        <li><%= link_to path, aria: { current: (current_place?(path) ? "page" : nil) } do %><%= icon icon_name %><%= name %><% end %></li>
      <% end %>
    </ul>
  </nav>
</div>
