<% content_for :title, "Map" %>
<% content_for :wide, true %>
<% content_for :head do %><%= turbo_refreshes_with method: :morph, scroll: :preserve %><% end %>
<% @map.stream_keys.each do |key| %><%= turbo_stream_from :board, key %><% end %>
<% sites = @map.sites %>

<%= render Ui::PageHeaderComponent.new(title: "Map", subtitle: "#{pluralize(sites.sum { it.servers.size }, "server")} in #{pluralize(sites.size, "place")}, and how they connect") %>

<%= render Ui::DisclosureComponent.new(summary: "Filters", open: @map.filters.any?) do %>
  <%= form_with url: map_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div><%= form.label :app %><%= form.search_field :app, value: @map.filters[:app], placeholder: "Service", compact: true %></div>
    <div><%= form.label :project %><%= form.select :project, @projects.map { [ it.name, it.id ] }, { include_blank: "All", selected: @map.filters[:project] }, compact: true %></div>
    <% Board::LABELS.each do |key| %>
      <div><%= form.label key %><%= form.select key, Board.new.label_values(key), { include_blank: "All", selected: @map.filters[key.to_sym] }, compact: true %></div>
    <% end %>
    <%= form.submit "Apply", name: nil, variant: :secondary %>
    <% if @map.filters.any? %><%= render Ui::ButtonComponent.new(label: "Clear", href: map_path, variant: :ghost) %><% end %>
  <% end %>
<% end %>

<%= render WorldMapComponent.new(map: @map) %>

<% unless @map.hub %>
  <%= render Ui::AlertComponent.new(tone: :info) do %>
    <% if current_user.admin? %><%= link_to "Set where Meridian runs", settings_account_path, class: "font-medium underline" %><% else %>An admin can set where Meridian runs<% end %>
    to see agent reports and deploys flowing on the map.
  <% end %>
<% end %>

<%= render Ui::SectionComponent.new(title: "Places", count: sites.size) do %>
  <%= render Ui::TableComponent.new(rows: sites.sort_by(&:name), empty: "No server has a location yet.") do |table| %>
    <% table.with_column("Place", header: true) { |site| site.name } %>
    <% table.with_column("Servers") { |site| safe_join(site.servers.first(6).map { link_to it.short_name, it, title: it.name, class: "font-mono text-xs hover:text-accent" }, ", ") + (" and #{site.servers.size - 6} more" if site.servers.size > 6).to_s } %>
    <% table.with_column("Apps") { |site| site.apps.map(&:name).first(5).join(", ") + (site.apps.size > 5 ? "…" : "") } %>
    <% table.with_column("State") { |site| render Ui::StateComponent.new(site.state) } %>
    <% table.with_column("Agents") { |site| site.stale? ? render(Ui::BadgeComponent.new("… quiet")) : "reporting" } %>
  <% end %>
  <% if (unlocated = @map.unlocated).any? %>
    <p class="text-xs text-ink-muted"><%= pluralize(unlocated.size, "server") %> without a location (<%= unlocated.first(5).map(&:short_name).join(", ") %><%= "…" if unlocated.size > 5 %>). Add <code>lat=…,lng=…</code> to <code>MERIDIAN_LABELS</code> on their agent, or set it on the server page.</p>
  <% end %>
<% end %>
