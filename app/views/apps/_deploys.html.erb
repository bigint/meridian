  <%= render Ui::SectionComponent.new(title: "Ship a version", id: "ship-heading") do %>
    <% if current_user.can_deploy? %>
      <div class="rounded-lg border border-line bg-canvas p-3">
        <%= form_with url: app_deploys_path(app), scope: :deploy, class: "space-y-3" do |form| %>
          <%= form.field :version, hint: safe_join([ "A past release or a new image tag. Meridian commits it to ", tag.code(app.version_file_path), ", and CI runs ", tag.code("kamal deploy"), "." ]) do %>
            <%= form.text_field :version, list: "versions-#{app.id}", required: true, pattern: "[\\w.+:@\\-]{1,128}", autocomplete: "off", placeholder: app.latest_release&.version %>
            <datalist id="versions-<%= app.id %>"><% app.releases.limit(20).map(&:version).uniq.each do |version| %><option value="<%= version %>"><% end %></datalist>
          <% end %>
          <div class="flex flex-wrap items-center gap-2">
            <%= form.submit "Deploy", data: { turbo_confirm: "Commit this version to #{app.version_file_path}?" } %>
          </div>
        <% end %>
        <% if app.latest_release %>
          <div class="mt-3 border-t border-line pt-3">
            <%= render Ui::ButtonComponent.new(label: "Redeploy #{app.latest_release.short_version}", href: app_redeploy_path(app), method: :post, size: :sm,
                  confirm: "Run the deploy workflow again for #{app.latest_release.version}? Use this after rotating a secret.") %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-ink-muted">Deployers and admins can deploy and roll back.</p>
    <% end %>
  <% end %>

  <%= render Ui::SectionComponent.new(title: "Current deploy", id: "deploy-heading") do %>
    <% if (deploy = app.current_deploy) %>
      <%= render DeployProgressComponent.new(deploy: deploy, app: app) %>
    <% else %>
      <p class="text-ink-muted">No deploys through Meridian yet.</p>
    <% end %>
  <% end %>
