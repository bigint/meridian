<% content_for :title, "Agents" %>
<%= page_header "Agents", meta: "Each server runs a small agent that reports its containers. A token lets it report; revoke the token to cut it off." %>

<% if @token&.token %>
  <%= alert_box :warn, title: "Copy this token now" do %>
    <p>Meridian keeps only a digest and can't show it again.</p>
    <%= render "shared/code_block", code: @token.token, label: "MERIDIAN_TOKEN" %>
  <% end %>
<% end %>

<div class="split">
  <%= titled_section "Install", class: "split__main" do %>
    <p class="txt-muted">Add the agent to a Kamal config that reaches every host, as two accessories. It only connects out to Meridian, and reads Docker through a proxy that allows nothing but reading containers: listing, inspecting, stats and logs. See <%= docs_link "The agent", "/guides/agent" %>.</p>
    <%= render "shared/code_block", code: Templates.render("kamal/agent-accessories.yml", meridian_url: request.base_url, agent_version: Rails.configuration.version == "dev" ? "latest" : Rails.configuration.version), label: "config/deploy.yml" %>
  <% end %>

  <div class="split__aside">
    <div class="card">
      <div class="card__header">Connect a server</div>
      <div class="card__body">
        <ol class="list-numbered txt-muted">
          <li>Create a token.</li>
          <li>Put it in <code>.kamal/secrets</code> as <code>MERIDIAN_TOKEN</code>.</li>
          <li>Once per host, create the <code>meridian</code> network the two share: <code>kamal server exec "docker network inspect meridian &gt;/dev/null 2&gt;&amp;1 || docker network create meridian"</code>.</li>
          <li>Run <code>kamal accessory boot meridian_docker</code>, then <code>meridian_agent</code>.</li>
        </ol>
        <%= form_with model: AgentToken.new, url: agent_tokens_path, class: "stack" do |form| %>
          <div class="field">
            <%= form.label :label %>
            <%= form.text_field :label, required: true, placeholder: "web-1" %>
            <%= field_errors(form.object, :label) %>
          </div>
          <label class="check">
            <%= form.check_box :fleet %>
            <span>Fleet token, shared by many servers <span class="block txt-small txt-muted">Identity comes from each machine id. One token per server is safer: revoking it affects only that server.</span></span>
          </label>
          <div><%= form.submit "Create token", class: "btn btn--primary" %></div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= titled_section "Tokens", count: @tokens.size do %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Label</th>
          <th scope="col">Server</th>
          <th scope="col">Last used</th>
          <th scope="col" class="table__end"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @tokens.each do |token| %>
          <tr>
            <th scope="row" class="nowrap"><span class="mono txt-small"><%= token.label %></span><%= badge("fleet", class: "ml-s") if token.fleet? %></th>
            <td class="nowrap"><%= token.server ? link_to(token.server.name, token.server, class: "mono txt-small") : tag.span(token.fleet? ? "many" : "binds on first contact", class: "txt-faint") %></td>
            <td class="nowrap"><%= token.revoked? ? badge("revoked", tone: :bad) : time_ago(token.last_used_at) %></td>
            <td class="table__end">
              <% unless token.revoked? %>
                <%= button_to "Revoke", agent_token_path(token), method: :delete, class: "btn btn--small btn--plain btn--danger",
                      form: { data: { turbo_confirm: "Revoke “#{token.label}”? Agents using it stop reporting." } } %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @tokens.none? %>
          <tr><td colspan="4" class="table__empty">No tokens yet. Create one to connect the first server.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<%= titled_section "Silent agents", count: @silent.size do %>
  <p class="txt-small txt-muted">Agents that haven't reported for three of their intervals, and at least <%= Server::STALE_AFTER.to_i %> seconds.</p>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Server</th>
          <th scope="col">Last seen</th>
          <th scope="col">Agent</th>
        </tr>
      </thead>
      <tbody>
        <% @silent.each do |server| %>
          <tr>
            <th scope="row"><%= link_to server.name, server, class: "mono txt-small" %></th>
            <td><%= time_ago(server.last_seen_at) %></td>
            <td class="mono txt-small"><%= server.agent_version %></td>
          </tr>
        <% end %>
        <% if @silent.none? %>
          <tr><td colspan="3" class="table__empty">Every agent is reporting.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @never.any? %>
    <p class="txt-small txt-muted">No agent has ever reported from <%= pluralize(@never.size, "server") %>: <%= safe_join(@never.first(20).map { link_to it.name, it }, ", ") %><%= "…" if @never.size > 20 %></p>
  <% end %>
<% end %>
