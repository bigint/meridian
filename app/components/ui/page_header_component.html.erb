<header class="border-b border-line pb-4">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <h1 class="text-xl font-semibold tracking-tight text-ink"><%= @title %></h1>
      <% if description? || @subtitle %>
        <div class="mt-1 text-ink-muted"><%= description? ? description : @subtitle %></div>
      <% end %>
    </div>
    <% if actions? %><div class="flex flex-wrap items-center gap-2"><%= actions %></div><% end %>
  </div>
  <% if tabs? %><div class="mt-4 -mb-4"><%= tabs %></div><% end %>
</header>
