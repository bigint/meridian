<% content_for :title, "Projects" %>
<%= page_header "Projects", meta: "A project is one Git repository that holds Kamal configs." do %>
  <%= link_to new_project_path, class: "btn btn--primary" do %><%= icon :plus %> Add project<% end %>
<% end %>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Project</th>
        <th scope="col">Repository</th>
        <th scope="col" class="table__end">Apps</th>
        <th scope="col">Synced</th>
        <th scope="col">Problems</th>
      </tr>
    </thead>
    <tbody>
      <% @projects.each do |project| %>
        <tr>
          <th scope="row"><%= link_to project.name, project %></th>
          <td class="mono txt-small"><%= link_to project.repo_full_name, project.repo_url %></td>
          <td class="table__end"><%= project.apps.size %></td>
          <td class="nowrap"><%= safe_join([ (short_sha(project.last_synced_sha) if project.last_synced_sha), time_ago(project.synced_at) ].compact, " ") %></td>
          <td><%= project.config_errors? ? badge("✕ #{pluralize(project.config_errors.size, "parse error")}", tone: :bad) : "–" %></td>
        </tr>
      <% end %>
      <% if @projects.none? %>
        <tr><td colspan="5" class="table__empty">No projects yet.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
