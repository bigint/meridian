<%# data-query is what was asked, as the box said it, so jump_controller.js can drop answers to what it no longer says. %>
<turbo-frame id="jump_results" target="_top">
  <% if @results.any? %>
    <ul class="results" data-query="<%= params[:q] %>">
      <% @results.each do |name, record, icon_name, kind| %>
        <li>
          <%= link_to record do %>
            <%= icon icon_name %>
            <span class="truncate"><%= name %></span>
            <span class="results__kind kind"><%= kind %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% elsif @query.present? %>
    <p class="results results__none" data-query="<%= params[:q] %>">Nothing called “<%= @query %>”.</p>
  <% end %>
</turbo-frame>
