<% content_for :title, "New app" %>
<header class="page-header"><h1>New app</h1></header>
<p class="meta">Meridian writes a Kamal config from a template, checks it with Kamal, and opens a pull request on the infra repository. Nothing runs until it is merged.</p>

<%= form_with model: @draft, url: apps_path, scope: :app_draft, class: "stack" do |form| %>
  <%= render "shared/errors", record: @draft %>

  <div class="columns">
    <div class="stack">
      <div class="field"><%= form.label :project_id, "Infra repository" %><%= form.select :project_id, Project.order(:name).map { [ "#{it.name} (#{it.repo_full_name})", it.id ] } %></div>
      <div class="field"><%= form.label :service, "Name" %><%= form.text_field :service, required: true, placeholder: "shop", pattern: "[a-z0-9][a-z0-9_\\-]*" %><span class="hint">Kamal's <code>service</code>. Lowercase.</span></div>
      <div class="field"><%= form.label :source_repo, "Source repository" %><%= form.text_field :source_repo, required: true, placeholder: "acme/shop" %><span class="hint">Where the app's code and Dockerfile live. Previews watch its pull requests.</span></div>

      <fieldset class="field">
        <legend><strong>Kind</strong></legend>
        <% App::KINDS.each do |kind| %>
          <label><%= form.radio_button :kind, kind %> <%= kind.capitalize %> <span class="meta">— <%= AppDraft::DESCRIPTIONS[kind] %>, port <%= AppDraft::PORTS[kind] %></span></label>
        <% end %>
      </fieldset>

      <div class="field"><%= form.label :hostname %><%= form.text_field :hostname, required: true, placeholder: "shop.example.com" %></div>
    </div>

    <div class="stack">
      <div class="field">
        <%= form.label :server_ids, "Servers" %>
        <%= form.select :server_ids, Server.ordered.group_by { it.label("region") || "unlabelled" }.sort.map { |region, servers| [ region, servers.map { [ it.name, it.id ] } ] }, {}, multiple: true, size: 10, grouped: true %>
        <span class="hint">Hold ⌘ or Ctrl to choose several.</span>
      </div>
      <div class="field"><%= form.label :label_selector, "…or every server with these labels" %><%= form.text_field :label_selector, placeholder: "role=web,region=sgp" %></div>
      <div class="field"><%= form.label :destination %><%= form.text_field :destination, placeholder: "production" %><span class="hint">Optional. Writes a base config plus a destination file.</span></div>
      <div class="field"><%= form.label :app_port, "Port" %><%= form.number_field :app_port, placeholder: "by kind" %></div>
      <div class="field"><%= form.label :registry %><%= form.text_field :registry %></div>
      <div class="field"><%= form.label :version, "First version" %><%= form.text_field :version %><span class="hint">The image tag CI will deploy once the pull request is merged.</span></div>
    </div>
  </div>

  <div><%= form.submit "Open pull request", class: "button primary" %> <%= link_to "Cancel", apps_path, class: "button" %></div>
<% end %>
