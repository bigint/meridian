<!DOCTYPE html>
<html lang="en" <%= tag.attributes(data: { theme: theme }) %>>
  <head>
    <title><%= [ content_for(:title), "Meridian" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="shell" data-controller="sidebar" <%= "data-collapsed" if sidebar_collapsed? %>>
      <aside id="sidebar" class="sidebar" popover aria-label="Navigation">
        <%= render "layouts/sidebar" %>
      </aside>

      <div class="min-w-0">
        <%= render "layouts/topbar" %>
        <main id="main" class="<%= content_for?(:wide) ? "main" : "main main--narrow" %>">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
