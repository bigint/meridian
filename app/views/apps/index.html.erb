<% content_for :title, "Apps" %>
<header class="page-header">
  <h1>Apps</h1>
  <%= form_with url: apps_path, method: :get, class: "filters" do |form| %>
    <%= form.label :q, "Search", class: "visually-hidden" %>
    <%= form.search_field :q, value: params[:q], placeholder: "Search apps", data: { filter: true } %>
  <% end %>
  <div class="actions"><%= link_to "New app", new_app_path, class: "button primary" if current_user.admin? %></div>
</header>

<table>
  <thead><tr><th>App</th><th>Project</th><th>Kind</th><th>Hostnames</th><th>Config</th><th>Latest release</th></tr></thead>
  <tbody>
    <% @apps.each do |app| %>
      <tr>
        <th scope="row"><%= link_to app.name, app %></th>
        <td><%= link_to app.project.name, app.project %></td>
        <td><span class="tag"><%= app.kind %></span></td>
        <td><%= app.hostnames.join(", ") %></td>
        <td><code><%= app.config_path %></code> <%= tag.code(app.destination_flag) if app.destination_flag %></td>
        <td><% if (release = app.latest_release) %><code><%= release.short_version %></code> <span class="meta"><%= time_ago(release.committed_at) %></span><% end %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<% if @apps.empty? %><p class="muted">No apps yet. They appear when a project syncs.</p><% end %>
