<% content_for :title, "Servers" %>
<header class="page-header">
  <h1>Servers</h1>
  <%= form_with url: servers_path, method: :get, class: "filters", data: { controller: "autosubmit" } do |form| %>
    <%= form.label :q, "Search", class: "visually-hidden" %>
    <%= form.search_field :q, value: params[:q], placeholder: "Search servers" %>
    <label><%= form.check_box :silent, { checked: @silent, data: { action: "autosubmit#submit" } }, "1", nil %> Only silent agents</label>
  <% end %>
</header>

<table>
  <thead><tr><th>Server</th><th>Hostname</th><th>Labels</th><th>Agent</th><th>Last seen</th></tr></thead>
  <tbody>
    <% @servers.each do |server| %>
      <tr>
        <th scope="row"><%= link_to server.name, server %></th>
        <td><%= tag.code(server.hostname) unless server.hostname == server.name %></td>
        <td><%= labels_list(server.labels) %></td>
        <td><%= server.agent_version || tag.span("no agent", class: "muted") %></td>
        <td><%= time_ago(server.last_seen_at) %><%= tag.span(" · silent", class: "state stale") if server.stale? %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<% if @servers.none? %><p class="muted">No servers.</p><% end %>
