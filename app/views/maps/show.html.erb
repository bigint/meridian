<% content_for :title, "Map" %>
<% content_for :wide, true %>
<% content_for :head do %><%= turbo_refreshes_with method: :morph, scroll: :preserve %><% end %>
<% @map.stream_keys.each do |key| %><%= turbo_stream_from :board, key %><% end %>
<% sites = @map.sites %>
<% services = @map.services %>
<% problems = @map.problems %>
<% deploying = sites.count { @map.deploying?(it) } %>

<%= page_header "Map", meta: "#{pluralize(sites.sum { it.servers.size }, "server")} in #{pluralize(sites.size, "place")}#{" · Meridian runs in #{@map.hub_name}" if @map.hub}" %>

<div class="chips" role="group" aria-label="Apps and places">
  <% if services.size.between?(2, 8) %>
    <span class="chips__label">App</span>
    <%= chip "All", services.size, current: @map.filters[:service].blank?, href: current_path_with(service: nil) %>
    <% services.each do |service, count| %>
      <%= chip service, count, current: @map.filters[:service] == service,
            href: current_path_with(service: (@map.filters[:service] == service ? nil : service)) %>
    <% end %>
    <span class="chips__rule" aria-hidden="true"></span>
  <% end %>
  <% if problems.any? || deploying.positive? %><span class="chips__label">Places</span><% end %>
  <% problems.each do |state, list| %><%= chip Drift::LABELS[state], list.size, state: state %><% end %>
  <% if deploying.positive? %><%= chip "Deploying", deploying, icon: :deploying, tone: "txt-info" %><% end %>
  <% if problems.empty? && deploying.zero? && sites.any? %><%= chip "Every place matches Git", nil, icon: :in_sync, tone: "txt-ok" %><% end %>
</div>

<%= render "boards/filters", url: map_path, filters: @map.filters, projects: @projects, group: false,
      hidden: { service: @map.filters[:service] },
      open: @map.filters.except(:service).any?,
      clear_url: (map_path if @map.filters.any?) %>

<div class="stack-l">
  <%= render "maps/world", map: @map %>

  <% unless @map.hub %>
    <%= alert_box do %><p>
      <%= link_to "Set where Meridian runs", settings_account_path %>
      to see agent reports and deploys flowing on the map.
    </p><% end %>
  <% end %>

  <%= titled_section "Places", count: sites.size do %>
    <% rows = @map.places %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th scope="col">Place</th><th scope="col">Region</th><th scope="col">Running</th><th scope="col">Agents</th></tr></thead>
        <tbody>
          <% rows.each do |site| %>
            <tr>
              <th scope="row"><%= link_to site.name, place_path(site) %></th>
              <td class="mono txt-small nowrap"><%= site.servers.filter_map { it.label("region") }.uniq.join(", ").presence || "–" %></td>
              <td><div class="cells"><% site.cells.sort_by { [ it.app.name, it.server.name ] }.each do |cell| %><%= version_cell cell %><% end %></div></td>
              <td class="nowrap"><%= site.stale? ? badge(state_icon("stale") + "Silent") : "reporting" %></td>
            </tr>
          <% end %>
          <% if rows.none? %><tr><td colspan="4" class="table__empty">No server has a location yet.</td></tr><% end %>
        </tbody>
      </table>
    </div>
    <% if (unlocated = @map.unlocated).any? %>
      <p class="txt-small txt-muted"><%= pluralize(unlocated.size, "server") %> without a location (<%= unlocated.first(5).map(&:short_name).join(", ") %><%= "…" if unlocated.size > 5 %>). Add <code>lat=…,lng=…</code> to <code>MERIDIAN_LABELS</code> on their agent, or set it on the server page.</p>
    <% end %>
  <% end %>
</div>
