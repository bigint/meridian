<% content_for :title, "Secrets" %>
<%= render Ui::PageHeaderComponent.new(title: "Secrets") do |header| %>
  <% header.with_description do %>
    Names come from <code>env.secret</code> and <code>registry.password</code> in your Kamal configs. Values go straight to each repository's encrypted Actions secrets; Meridian never stores, logs or shows them.
  <% end %>
<% end %>

<% @projects.each do |project| %>
  <%= render Ui::SectionComponent.new(title: project.name, count: project.secret_names.size, id: "project-#{project.id}") do |section| %>
    <% section.with_actions { tag.span(project.repo_full_name, class: "font-mono text-xs text-ink-muted") } %>
    <%= render Ui::TableComponent.new(rows: project.secret_names.sort_by(&:name), empty: "No configs reference secrets.") do |table| %>
      <% table.with_column("Name", header: true) { |secret| tag.code(secret.name) } %>
      <% table.with_column("Used by") { |secret| secret.referenced? ? secret.apps.join(", ") : tag.span("not referenced by any config", class: "text-ink-faint") } %>
      <% table.with_column("Last set") { |secret| secret.last_set_at ? safe_join([ time_ago(secret.last_set_at), " by ", secret.last_set_by&.display_name ]) : tag.span("not set through Meridian", class: "text-ink-faint") } %>
      <% if current_user.admin? %>
        <% table.with_column("Set or rotate") do |secret| %>
          <%= form_with url: secret_path(secret), method: :patch, class: "flex items-center gap-2" do |form| %>
            <%= form.label :secret_value, "Value for #{secret.name}", class: "sr-only", for: "value-#{secret.id}" %>
            <%= form.password_field :secret_value, id: "value-#{secret.id}", required: true, autocomplete: "off", value: nil, compact: true %>
            <%= form.submit secret.last_set_at ? "Rotate" : "Set", variant: :secondary %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <% if current_user.admin? %>
      <%= render Ui::DisclosureComponent.new(summary: "Add another name") do %>
        <%= form_with model: SecretName.new, url: secrets_path(project_id: project.id), class: "flex flex-wrap items-end gap-3" do |form| %>
          <div><%= form.label :name %><%= form.text_field :name, required: true, placeholder: "DATABASE_URL", pattern: "[A-Za-z_][A-Za-z0-9_]*", compact: true %></div>
          <div>
            <label for="secret_value_<%= project.id %>" class="mb-1 block text-xs font-medium text-ink-muted">Value (optional)</label>
            <%= password_field_tag :secret_value, nil, id: "secret_value_#{project.id}", autocomplete: "off", class: "#{MeridianFormBuilder::INPUT} #{MeridianFormBuilder::SIZES[:compact]} w-auto" %>
          </div>
          <%= form.submit "Add", variant: :secondary %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
