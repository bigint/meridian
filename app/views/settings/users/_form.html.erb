<%= form_with model: user, url: user.persisted? ? settings_user_path(user) : settings_users_path, class: "stack-l" do |form| %>
  <%= render "shared/errors", record: user %>
  <div class="card">
    <div class="card__body">
      <div class="fields">
        <div class="field">
          <%= form.label :name %>
          <%= form.text_field :name %>
          <%= field_errors(user, :name) %>
        </div>
        <div class="field">
          <%= form.label :email_address, "Email" %>
          <%= form.email_field :email_address, required: true %>
          <%= field_errors(user, :email_address) %>
        </div>
        <div class="field">
          <%= form.label :password %>
          <%= form.password_field :password, required: user.new_record?, autocomplete: "new-password", minlength: 12, maxlength: 72 %>
          <p class="field__hint"><%= user.persisted? ? "Leave blank to keep the current password." : "At least 12 characters. Share it with them privately." %></p>
          <%= field_errors(user, :password) %>
        </div>
        <div class="field">
          <%= form.label :role %>
          <%= form.select :role, User::ROLES.map { [ it.capitalize, it ] } %>
          <%= field_errors(user, :role) %>
        </div>
      </div>
    </div>
  </div>
  <div class="flex gap-s">
    <%= form.submit class: "btn btn--primary" %>
    <%= link_to "Cancel", settings_users_path, class: "btn btn--plain" %>
  </div>
<% end %>
