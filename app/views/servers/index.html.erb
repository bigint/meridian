<% content_for :title, "Servers" %>
<%= page_header "Servers", meta: "Every machine Git names or an agent reports from." do %>
  <%= form_with url: servers_path, method: :get, class: "filters items-center", data: { controller: "autosubmit" } do |form| %>
    <%= form.label :q, "Search servers", class: "sr-only" %><%= form.search_field :q, value: params[:q], placeholder: "Search servers" %>
    <label class="check items-center"><%= form.check_box :silent, { checked: @silent, data: { action: "autosubmit#submit" } }, "1", nil %> <span>Only silent agents</span></label>
  <% end %>
<% end %>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Server</th>
        <th scope="col">Hostname</th>
        <th scope="col">Place</th>
        <th scope="col">Labels</th>
        <th scope="col">Agent</th>
        <th scope="col">Last seen</th>
      </tr>
    </thead>
    <tbody>
      <% @servers.each do |server| %>
        <tr>
          <th scope="row"><%= link_to server.name, server, class: "mono txt-small" %></th>
          <td class="mono txt-small"><%= server.hostname unless server.hostname == server.name %></td>
          <td class="nowrap"><%= place(server) %></td>
          <td><%= labels_list(server.labels, except: Server::PLACE_LABELS) %></td>
          <td class="mono txt-small"><%= server.agent_version || tag.span("no agent", class: "txt-faint") %></td>
          <td class="nowrap"><%= safe_join([ time_ago(server.last_seen_at), (badge("silent") if server.stale?) ].compact, " ") %></td>
        </tr>
      <% end %>
      <% if @servers.none? %>
        <tr><td colspan="6" class="table__empty">No servers.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
