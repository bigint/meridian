<div class="space-y-5" data-inspector>
  <div class="space-y-1.5">
    <p class="text-[11px] font-semibold tracking-wide text-ink-muted">APP</p>
    <h2 class="text-lg font-bold tracking-tight text-ink"><%= link_to @app.name, @app, class: "hover:text-accent" %></h2>
    <div class="flex flex-wrap items-center gap-2 text-ink-muted">
      <%= render Ui::BadgeComponent.new(@app.kind) %>
      <span>in <%= @app.project.name %></span>
    </div>
    <div><%= render AppStatusComponent.new(app: @app, cells: cells) %></div>
  </div>

  <% if @user.can_deploy? %>
    <%= form_with url: helpers.app_deploys_path(@app), scope: :deploy, class: "space-y-2 rounded-lg border border-line bg-canvas p-3" do |form| %>
      <%= form.label :version, "Ship a version", for: "inspector-version", class: "!mb-0 !text-ink font-semibold" %>
      <div class="flex gap-2">
        <%= form.text_field :version, id: "inspector-version", required: true, pattern: "[\\w.+:@\\-]{1,128}", autocomplete: "off",
              placeholder: @app.latest_release&.version, class: "font-mono !max-w-none flex-1", compact: true %>
        <%= form.submit "Deploy", data: { turbo_confirm: "Commit this version to #{@app.version_file_path}?" } %>
      </div>
      <p class="text-xs text-ink-muted">Commits the tag to <code><%= @app.version_file_path %></code>; CI runs <code>kamal deploy</code>.</p>
    <% end %>
  <% end %>

  <%= render Ui::SectionComponent.new(title: "Servers", count: cells.size, id: "inspector-servers") do %>
    <% if cells.any? %>
      <ul class="divide-y divide-line rounded-lg border border-line bg-canvas">
        <% cells.each do |cell| %>
          <li class="flex items-center gap-2.5 px-3 py-1.5">
            <%= render VersionCellComponent.new(cell: cell) %>
            <%= link_to cell.server.name, cell.server, class: "truncate font-mono text-xs text-ink hover:text-accent" %>
            <span class="ml-auto shrink-0 text-xs text-ink-muted"><%= place(cell.server) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-ink-muted">Not assigned to any server.</p>
    <% end %>
  <% end %>

  <%= render Ui::SectionComponent.new(title: "Recent releases", id: "inspector-releases") do %>
    <% if releases.any? %>
      <ol class="space-y-2.5">
        <% releases.each do |release| %>
          <li class="flex items-baseline gap-3">
            <code class="w-14 shrink-0 font-semibold text-ink"><%= release.short_version %></code>
            <span class="min-w-0">
              <span class="block truncate text-ink"><%= release.message %></span>
              <span class="text-xs text-ink-muted"><%= release.author %> · <code><%= release.short_sha %></code> · <%= helpers.time_ago(release.committed_at) %></span>
            </span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="text-ink-muted">No releases yet.</p>
    <% end %>
  <% end %>

  <div class="flex flex-wrap gap-2">
    <% if @user.can_deploy? && @app.latest_release %>
      <%= render Ui::ButtonComponent.new(label: "Redeploy", href: helpers.app_redeploy_path(@app), method: :post, size: :sm,
            confirm: "Run the deploy workflow again for #{@app.latest_release.version}? Use this after rotating a secret.") %>
    <% end %>
    <% if can_roll_back? %>
      <%= render Ui::ButtonComponent.new(label: "Roll back", href: helpers.app_rollbacks_path(@app, release_id: releases.first.id), method: :post, variant: :danger, size: :sm,
            confirm: "Revert #{releases.first.short_sha} so the version file goes back to its previous value? CI deploys the result.") %>
    <% end %>
    <%= render Ui::ButtonComponent.new(label: "Open app page", href: helpers.app_path(@app), variant: :ghost, size: :sm) %>
  </div>
</div>
