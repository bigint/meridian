<% content_for :title, "#{@draft.service} proposed" %>
<header class="page-header">
  <h1><%= @draft.service %> is <%= @proposal.direct ? "committed" : "ready for review" %></h1>
  <div class="actions"><%= link_to @proposal.direct ? "View commit" : "Open pull request ##{@proposal.number}", @proposal.url, class: "button primary" %></div>
</header>

<p>It appears on the board once <%= @proposal.direct ? "the project syncs" : "the pull request is merged" %>.</p>

<div class="columns">
  <section>
    <h2>Still to do by hand</h2>
    <ol><% @draft.manual_steps.each do |step| %><li><%= step %></li><% end %></ol>
    <h2>Files</h2>
    <% @draft.files.each do |path, content| %>
      <h3><code><%= path %></code></h3>
      <pre class="snippet"><code><%= content %></code></pre>
    <% end %>
  </section>
  <section>
    <h2>Dockerfile for <%= @draft.source_repo %></h2>
    <pre class="snippet"><code><%= @draft.instructions %></code></pre>
  </section>
</div>
