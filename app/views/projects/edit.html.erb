<% content_for :title, "Edit #{@project.name}" %>
<header class="page-header">
  <h1>Edit <%= @project.name %></h1>
  <div class="actions"><%= button_to "Remove project", @project, method: :delete, class: "button danger", form: { data: { turbo_confirm: "Remove this project from Meridian? Nothing in Git changes." } } %></div>
</header>
<%= render "form", project: @project %>
