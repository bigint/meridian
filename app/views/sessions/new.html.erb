<% content_for :title, "Sign in" %>
<h1 class="text-lg font-semibold">Sign in</h1>

<%= form_with url: session_path, class: "space-y-4" do |form| %>
  <%= form.field :email_address, label: "Email" do %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "!max-w-none" %>
  <% end %>
  <%= form.field :password do %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "!max-w-none" %>
  <% end %>
  <%= form.submit "Sign in", class: "w-full justify-center" %>
<% end %>

<% if Meridian.oidc? %>
  <%= render Ui::ButtonComponent.new(label: "Sign in with #{Meridian.oidc_name}", href: "/auth/oidc", method: :post, class: "w-full", data: { turbo: false }) %>
<% end %>
