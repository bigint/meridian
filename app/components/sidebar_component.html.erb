<div class="flex h-full flex-col gap-1 p-3 lg:items-center lg:px-3 lg:py-3.5">
  <%= link_to helpers.root_path, class: "mb-3 flex items-center gap-2 px-2.5 font-semibold text-ink lg:px-0", title: "Meridian" do %>
    <%= helpers.icon(:logo, class: "size-6 text-accent") %><span class="lg:sr-only">Meridian</span>
  <% end %>

  <nav aria-label="Main" class="flex flex-col gap-1">
    <% primary.each do |name, path, icon, badge| %><%= nav_link(name, path, icon, badge) %><% end %>
  </nav>

  <nav aria-label="Manage" class="mt-3 flex flex-col gap-1 border-t border-line pt-3">
    <% secondary.each do |name, path, icon| %><%= nav_link(name, path, icon) %><% end %>
  </nav>

  <% if admin.any? %>
    <nav aria-label="Admin" class="mt-auto flex flex-col gap-1 pt-3">
      <% admin.each do |name, path, icon| %><%= nav_link(name, path, icon) %><% end %>
    </nav>
  <% end %>
</div>
