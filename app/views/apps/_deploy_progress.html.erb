<%# The current deploy: who, what, CI, and each server's progress as its
    agent reports the new version running. locals: deploy, app %>
<div class="card">
  <div class="card__header">
    <span class="flex flex-wrap items-center gap-s min-w-0"><%= badge deploy.state_label, tone: deploy_tone(deploy) %><span><%= deploy_heading(deploy) %></span></span>
    <span class="txt-small txt-muted nowrap"><%= time_ago(deploy.created_at) %></span>
  </div>
  <div class="card__meta">
    <span>By <%= deploy.requested_by %></span>
    <span>Commit <%= link_to deploy.commit_sha.first(7), app.project.git.commit_url(deploy.commit_sha), class: "mono link" %></span>
    <% if deploy.ci_url %><%= link_to "CI run ↗", deploy.ci_url, class: "link", target: "_blank", rel: "noopener" %><% end %>
  </div>
  <ul>
    <% deploy.progress.each do |server, versions, done| %>
      <li class="row">
        <%= link_to server.short_name, server, class: "mono txt-small nowrap", data: { tooltip: server.name } %>
        <span class="row__trail row__trail--shrink ml-auto">
          <%= tag.code versions.map { it.first(12) }.join(", ").presence || "–", class: "truncate", data: { tooltip: versions.join(", ").presence } %>
          <%= badge(done ? "✓ Running #{deploy.version.first(12)}" : "… Waiting", tone: (done ? :ok : nil), data: { tooltip: (deploy.version if done) }) %>
        </span>
      </li>
    <% end %>
  </ul>
</div>
