<% content_for :title, "Edit #{@user.display_name}" %>
<%= render Ui::PageHeaderComponent.new(title: @user.display_name, subtitle: @user.email_address) do |header| %>
  <% unless @user == current_user %>
    <% header.with_actions { render Ui::ButtonComponent.new(label: "Remove", href: settings_user_path(@user), method: :delete, variant: :danger, confirm: "Remove #{@user.email_address}?") } %>
  <% end %>
<% end %>
<%= render "form", user: @user %>
