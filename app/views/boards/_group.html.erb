<details class="grid-group" open id="group-<%= group.key %>">
  <summary>
    <%= board.group_by ? "#{board.group_by.capitalize}: #{group.name || "unlabelled"}" : "All servers" %>
    <span class="meta">· <%= pluralize(group.rows.size, board.view == "apps" ? "app" : "server") %> × <%= pluralize(group.columns.size, board.view == "apps" ? "server" : "app") %></span>
  </summary>
  <div class="scroll">
    <table class="grid">
      <thead>
        <tr>
          <th scope="col"><%= board.view == "apps" ? "App" : "Server" %></th>
          <% group.columns.each do |column| %>
            <th scope="col" class="<%= "server" if column.is_a?(Server) %>"><%= link_to column.try(:short_name) || column.name, column, title: column.name %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% group.rows.each do |row| %>
          <tr>
            <th scope="row"><%= link_to row.name, row, title: row.try(:hostname) %></th>
            <% group.columns.each do |column| %>
              <% cell = group.cell(row, column) %>
              <td class="cell">
                <% if cell %>
                  <%= drift_badge(cell.state) %>
                  <span class="version" title="<%= cell.roles.join(", ") %>"><%= cell.version.to_s.first(12) %></span>
                  <%= health_text(cell.health) if cell.health == "unhealthy" %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</details>
