<% content_for :title, "Activity" %>
<%= page_header "Activity", meta: "Everything Meridian did, and who asked for it." %>

<%= disclosure "Filters", open: params[:action_name].present? do %>
  <%= form_with url: events_path, method: :get, class: "filters" do |form| %>
    <div class="field"><%= form.label :action_name, "Action starts with" %><%= form.search_field :action_name, value: params[:action_name], placeholder: "app.deploy" %></div>
    <%= form.submit "Apply", name: nil, class: "btn" %>
  <% end %>
<% end %>

<% if @events.empty? %>
  <%= empty_state(params[:action_name].present? ? "No action starts with #{params[:action_name]}" : "Nothing has happened yet", icon_name: :activity) %>
<% end %>

<div class="stack-l">
  <% @events.group_by { it.created_at.to_date }.each do |date, events| %>
    <section aria-label="<%= date.to_fs(:long) %>" class="flex-col gap-s">
      <h2 class="flex items-center gap-s txt-medium">
        <%= date == Date.current ? "Today" : date == Date.yesterday ? "Yesterday" : date.strftime("%A, %B %-d") %>
        <span class="mono txt-small txt-faint txt-normal"><%= date.iso8601 %></span>
      </h2>
      <ul class="rows">
        <% events.each do |event| %>
          <li class="row">
            <%= avatar event.actor_name, small: true %>
            <div class="row__body">
              <div class="row__title"><%= event.summary %></div>
              <div class="row__meta">
                <%= event.actor_name %> · <code><%= event.action %></code>
                <% if event.details["commit"] %> · <%= short_sha(event.details["commit"]) %><% end %>
                <% if event.details["pull_request"] %> · <%= link_to "pull request", event.details["pull_request"], class: "link" %><% end %>
                <% if event.details["ci_url"] %> · <%= link_to "CI run ↗", event.details["ci_url"], class: "link" %><% end %>
              </div>
            </div>
            <div class="row__trail"><%= tag.time(event.created_at.strftime("%H:%M"), datetime: event.created_at.iso8601, class: "mono") %></div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>

<%= pagination label: "Page #{@page}", previous_label: "Newer", next_label: "Older",
      previous_url: (current_path_with(page: @page - 1) if @page > 1),
      next_url: (current_path_with(page: @page + 1) if @more) %>
