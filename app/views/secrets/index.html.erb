<% content_for :title, "Secrets" %>
<header class="page-header"><h1>Secrets</h1></header>
<p class="meta">Names come from the <code>env.secret</code> and <code>registry.password</code> entries in your Kamal configs. Values go straight to each repository's encrypted Actions secrets. Meridian never stores, logs or shows them.</p>

<% @projects.each do |project| %>
  <section id="project-<%= project.id %>">
    <h2><%= project.name %> <span class="meta"><%= project.repo_full_name %></span></h2>
    <table>
      <thead><tr><th>Name</th><th>Used by</th><th>Last set</th><% if current_user.admin? %><th>Set or rotate</th><% end %></tr></thead>
      <tbody>
        <% project.secret_names.sort_by(&:name).each do |secret| %>
          <tr>
            <th scope="row"><code><%= secret.name %></code></th>
            <td><%= secret.referenced? ? secret.apps.join(", ") : tag.span("not referenced by any config", class: "muted") %></td>
            <td><%= secret.last_set_at ? safe_join([ time_ago(secret.last_set_at), " by ", secret.last_set_by&.display_name ]) : tag.span("not set through Meridian", class: "muted") %></td>
            <% if current_user.admin? %>
              <td>
                <%= form_with url: secret_path(secret), method: :patch, class: "filters" do |form| %>
                  <%= form.label :secret_value, "Value for #{secret.name}", class: "visually-hidden", for: "value-#{secret.id}" %>
                  <%= form.password_field :secret_value, id: "value-#{secret.id}", required: true, autocomplete: "off", value: nil %>
                  <%= form.submit secret.last_set_at ? "Rotate" : "Set", class: "button" %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if project.secret_names.empty? %><p class="muted">No configs reference secrets.</p><% end %>

    <% if current_user.admin? %>
      <details>
        <summary class="meta">Add another name</summary>
        <%= form_with model: SecretName.new, url: secrets_path(project_id: project.id), class: "filters" do |form| %>
          <div><%= form.label :name %><%= form.text_field :name, required: true, placeholder: "DATABASE_URL", pattern: "[A-Za-z_][A-Za-z0-9_]*" %></div>
          <div><%= label_tag "secret_value_#{project.id}", "Value (optional)" %><%= password_field_tag :secret_value, nil, id: "secret_value_#{project.id}", autocomplete: "off" %></div>
          <%= form.submit "Add", class: "button" %>
        <% end %>
      </details>
    <% end %>
  </section>
<% end %>
