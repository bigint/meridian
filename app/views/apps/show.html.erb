<% content_for :title, @app.name %>
<% content_for :wide, true %>
<% content_for :head do %><%= turbo_refreshes_with method: :morph, scroll: :preserve %><% end %>
<% @board.stream_keys.each do |key| %><%= turbo_stream_from :board, key %><% end %>
<%= turbo_stream_from @app %>
<% group = @board.groups.first %>
<% cells = group ? group.columns.map { group.cell(@app, it) } : [] %>

<header class="page-header">
  <div class="page-header__row">
    <h1 class="page-header__title"><%= @app.name %></h1>
    <div class="page-header__actions">
      <%= link_to app_traffic_path(@app), class: "btn btn--small", data: { turbo_prefetch: false } do %><%= icon :traffic %>Traffic<% end %>
      <%= link_to app_log_path(@app), class: "btn btn--small", data: { turbo_prefetch: false } do %><%= icon :logs %>Logs<% end %>
    </div>
  </div>
  <div class="flex flex-wrap items-center gap-s txt-muted">
    <%= badge @app.kind %>
    <span>in <%= link_to @app.project.name, @app.project, class: "link" %></span>
    <% @app.hostnames.each do |host| %><%= link_to host, "https://#{host}", class: "link mono txt-small" %><% end %>
  </div>
  <div><%= app_status @app, cells %></div>
</header>

<div class="split">
  <div class="split__main">
    <%= titled_section "Servers", count: cells.size do %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th scope="col">Running</th><th scope="col">Server</th><th scope="col">State</th><th scope="col">Roles</th><th scope="col">Health</th><th scope="col">Place</th></tr></thead>
          <tbody>
            <% cells.each do |cell| %>
              <tr>
                <td><%= version_cell cell %></td>
                <th scope="row"><%= link_to cell.server.name, cell.server, class: "mono txt-small" %></th>
                <td><%= state_badge cell.state %></td>
                <td><%= cell.roles.join(", ") %></td>
                <td><%= cell.health == "unhealthy" ? badge("unhealthy", tone: :bad) : cell.health %></td>
                <td class="nowrap"><%= place(cell.server) %></td>
              </tr>
            <% end %>
            <% if cells.none? %><tr><td colspan="6" class="table__empty">Not assigned to any server.</td></tr><% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @accessories.any? %>
      <%= titled_section "Accessories", count: @accessories.size do %>
        <p class="txt-small txt-muted">Run beside the app from the same config, such as databases and caches. Kamal starts them with <code>kamal accessory boot</code>; <code>kamal deploy</code> leaves them alone.</p>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th scope="col">Accessory</th><th scope="col">Image</th><th scope="col">Server</th><th scope="col">State</th><th scope="col">Started</th></tr></thead>
            <tbody>
              <% @accessories.each do |accessory| %>
                <% accessory.instances.each_with_index do |instance, index| %>
                  <tr>
                    <% if index.zero? %>
                      <th scope="rowgroup" rowspan="<%= accessory.instances.size %>"><span class="mono"><%= accessory.name %></span></th>
                      <td rowspan="<%= accessory.instances.size %>" class="mono txt-small"><%= accessory.image || "–" %></td>
                    <% end %>
                    <td class="nowrap"><span class="mono txt-small"><%= instance.server ? link_to(instance.host, instance.server) : instance.host %></span></td>
                    <td><%= accessory_state_badge(instance) %></td>
                    <td class="nowrap"><%= instance.placement&.started_at ? time_ago(instance.placement.started_at) : "–" %></td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
        <% @accessories.select { it.missing.any? }.each do |accessory| %>
          <p class="txt-small txt-muted">Start <span class="mono"><%= accessory.name %></span> with <%= copyable accessory.boot_command %></p>
        <% end %>
      <% end %>
    <% end %>

    <%= titled_section "Releases", count: @releases.size do %>
      <p class="txt-small txt-muted">From the Git history of <code><%= @app.release_source_path %></code>.</p>
      <% if @releases.any? %>
        <ul class="rows">
          <% @releases.each_with_index do |release, index| %>
            <li class="row">
              <%= avatar release.author.to_s, small: true %>
              <div class="row__body">
                <div class="row__title"><code class="txt-strong"><%= release.short_version %></code> <%= release.message %> <% if index.zero? %><%= badge "newest", tone: :accent %><% end %></div>
                <div class="row__meta"><%= release.author %> · <%= link_to release.short_sha, @app.project.git.commit_url(release.commit_sha), class: "mono" %></div>
              </div>
              <div class="row__trail">
                <%= time_ago(release.committed_at) %>
                <% if index.zero? && @releases.size > 1 && @app.versioned? && @app.deployable? %>
                  <%= button_to "Roll back", app_rollbacks_path(@app, release_id: release.id), class: "btn btn--small btn--danger",
                        form: { data: { turbo_confirm: "Revert #{release.short_sha} so the version file goes back to its previous value? CI deploys the result." } } %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= empty_state "No releases yet", icon_name: :activity %>
      <% end %>
    <% end %>

    <%= disclosure "Configuration" do %>
      <dl class="facts">
        <dt>Config</dt><dd><%= link_to @app.config_path, @app.project.git.file_url(@app.config_path), class: "mono" %> <%= tag.code(@app.destination_flag) if @app.destination_flag %></dd>
        <dt>Image</dt><dd><code><%= @app.image %></code></dd>
        <dt>Roles</dt><dd><%= @app.roles.map { "#{it["name"]} (#{pluralize(it["hosts"].size, "host")})" }.join(", ").presence || "–" %></dd>
        <dt>Version file</dt><dd><%= @app.version_path ? tag.code(@app.version_path) : tag.span("none yet: drift can't compare versions until one exists", class: "txt-muted") %></dd>
        <dt>Source</dt><dd><%= @app.source_repo.presence || tag.span("not set", class: "txt-muted") %></dd>
        <dt>Secrets</dt><dd><%= @app.secret_names.join(", ").presence || "–" %></dd>
      </dl>
    <% end %>
  </div>

  <aside class="split__aside" aria-label="Deploy">
    <div class="panel">
      <% if @app.deployable? %>
        <%= render "apps/deploys", app: @app %>
      <% else %>
        <p class="txt-muted">This config only runs accessories, so it is never deployed. Start them with <code>kamal accessory boot all -c <%= @app.config_path %></code>.</p>
      <% end %>
    </div>
  </aside>
</div>
