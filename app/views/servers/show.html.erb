<% content_for :title, @server.name %>
<% content_for :wide, true %>
<% content_for :head do %><%= turbo_refreshes_with method: :morph, scroll: :preserve %><% end %>
<%# Its own region's stream too: a server with nothing on the board yet has no cell to take it from. %>
<% (@board.stream_keys | [ Board.stream_key(@server) ]).each do |key| %><%= turbo_stream_from :board, key %><% end %>
<%# Every app here, not one board page of them. %>
<% cells = @board.cells.sort_by { it.app.name } %>

<% status = capture do %>
  <% if @server.stale? %><%= state_badge "stale" %> agent silent
  <% elsif !@server.reporting? %><%= badge "No agent yet" %>
  <% else %><%= badge "Reporting", tone: :ok %><% end %>
  <%= place(@server) %>
<% end %>
<%= page_header @server.name, meta: status %>

<div class="split">
  <div class="split__main" data-controller="live-stats" data-live-stats-server-id-value="<%= @server.id %>" data-action="turbo:morph@document->live-stats#apply">
    <%= render "live", server: @server %>

    <%= titled_section "Apps", count: cells.size do %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Running</th>
              <th scope="col">App</th>
              <th scope="col">State</th>
              <th scope="col">Roles</th>
            </tr>
          </thead>
          <tbody>
            <% cells.each do |cell| %>
              <tr>
                <td><%= version_cell cell %></td>
                <th scope="row"><%= link_to cell.app.name, cell.app %></th>
                <td><%= state_badge cell.state %></td>
                <td><%= cell.roles.join(", ") %></td>
              </tr>
            <% end %>
            <% if cells.none? %>
              <tr><td colspan="4" class="table__empty">Nothing assigned here.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <%= titled_section "Containers", count: @placements.size do %>
      <p class="txt-small txt-muted">What runs with Kamal labels, as the agent last reported it. Stopped containers Kamal keeps for rollback are left out.</p>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Container</th>
              <th scope="col">Version</th>
              <th scope="col">State</th>
              <th scope="col" class="table__end">CPU</th>
              <th scope="col" class="table__end">Memory</th>
              <th scope="col" class="table__end">Network<span class="sr-only"> in and out per second</span></th>
              <th scope="col">Started</th>
              <th scope="col"><span class="sr-only">Logs</span></th>
            </tr>
          </thead>
          <tbody>
            <% @placements.each do |placement| %>
              <tr <%= tag.attributes(data: { live_container: (placement.container_id if placement.running?) }) %>>
                <td>
                  <div>
                    <%= safe_join([ (placement.app ? link_to(placement.service, placement.app) : placement.service), (badge(placement.kind) unless placement.kind == "app"), (tag.span("· #{placement.role}", class: "txt-faint") if placement.role) ].compact, " ") %>
                  </div>
                  <div class="container-cell__name mono txt-small txt-faint" data-tooltip="<%= placement.name %>"><%= placement.name %></div>
                </td>
                <td class="mono txt-small"><%= placement.short_version %></td>
                <td class="nowrap">
                  <%= placement.state %>
                  <% if placement.health == "unhealthy" %><%= badge("unhealthy", tone: :bad) %><% elsif placement.health.present? %><span class="txt-faint">· <%= placement.health %></span><% end %>
                </td>
                <td class="stat" aria-live="off">
                  <span class="stat__value" data-part="cpu">—</span>
                  <span class="meter" aria-hidden="true"><span class="meter__fill" data-part="cpu-meter"></span></span>
                </td>
                <td class="stat stat--memory" aria-live="off">
                  <span class="stat__value" data-part="memory">—</span>
                  <span class="meter" aria-hidden="true"><span class="meter__fill" data-part="memory-meter"></span></span>
                </td>
                <td class="stat stat--net" aria-live="off">
                  <span class="stat__value"><span class="sr-only">In </span><%= icon :download, width: 12, height: 12 %><span data-part="rx">—</span></span>
                  <span class="stat__value"><span class="sr-only">Out </span><%= icon :upload, width: 12, height: 12 %><span data-part="tx">—</span></span>
                </td>
                <td class="nowrap"><%= time_ago(placement.started_at) %></td>
                <td><%= link_to icon(:logs), placement_log_path(placement), class: "btn btn--icon btn--plain btn--small", aria: { label: "Logs of #{placement.name}" }, data: { turbo_prefetch: false, tooltip: "Logs" } %></td>
              </tr>
            <% end %>
            <% if @placements.none? %>
              <tr><td colspan="8" class="table__empty">No containers reported.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <aside class="split__aside" aria-label="Machine">
    <div class="panel">
      <%= titled_section "Machine" do %>
        <div class="card">
          <div class="card__body">
            <dl class="facts">
              <dt>Hostname</dt>
              <dd><code><%= @server.hostname %></code></dd>
              <dt>Agent</dt>
              <dd><%= @server.agent_version || "not installed" %></dd>
              <dt>Last seen</dt>
              <dd><%= time_ago(@server.last_seen_at) %></dd>
              <dt>Location</dt>
              <dd><%= @server.located? ? "#{@server.latitude}, #{@server.longitude}" : tag.span("not set", class: "txt-faint") %></dd>
              <dt>Projects</dt>
              <dd><%= safe_join(@server.projects.map { link_to it.name, it }, ", ").presence || tag.span("none", class: "txt-faint") %></dd>
            </dl>
          </div>
        </div>
      <% end %>

      <% if @server.labels.except(*Server::PLACE_LABELS).any? %>
        <%= titled_section "Labels" do %>
          <div class="flex flex-wrap gap-xs"><%= labels_list(@server.labels, except: Server::PLACE_LABELS) %></div>
        <% end %>
      <% end %>

      <%= titled_section "Location on the map" do %>
        <%= form_with model: @server, class: "filters" do |form| %>
          <div class="field"><%= form.label :latitude %><%= form.number_field :latitude, step: "any", min: -90, max: 90 %></div>
          <div class="field"><%= form.label :longitude %><%= form.number_field :longitude, step: "any", min: -180, max: 180 %></div>
          <%= form.submit "Save location", name: nil, class: "btn" %>
        <% end %>
        <p class="txt-small txt-muted">An agent that reports <code>lat</code> and <code>lng</code> labels overrides this on its next snapshot.</p>
      <% end %>
    </div>
  </aside>
</div>
