<% content_for :title, "Previews" %>
<% content_for :head do %><%= turbo_refreshes_with method: :morph, scroll: :preserve %><% end %>
<%= turbo_stream_from :previews %>
<%= render Ui::PageHeaderComponent.new(title: "Previews") do |header| %>
  <% header.with_description do %>
    A pull request in an app's source repository gets <code>pr-&lt;n&gt;.&lt;app&gt;.<%= Account.current.preview_domain.presence || "&lt;preview domain&gt;".html_safe %></code>.
    <%= link_to "Set the preview domain", settings_account_path, class: "text-accent-strong hover:underline" if Account.current.preview_domain.blank? && current_user.admin? %>
  <% end %>
<% end %>

<%= render Ui::TableComponent.new(rows: @previews, empty: "No open previews. They appear when a pull request opens in an app's source repository.") do |table| %>
  <% table.with_column("App", header: true) { |preview| link_to preview.app.name, preview.app, class: "hover:underline" } %>
  <% table.with_column("Pull request") { |preview| safe_join([ link_to("#{preview.app.source_repo}##{preview.pr_number}", preview.pr_url, class: "hover:underline"), (tag.span(short_sha(preview.head_sha), class: "font-mono text-xs text-ink-muted") if preview.head_sha) ].compact, " ") } %>
  <% table.with_column("URL", mono: true) { |preview| link_to preview.hostname, preview.url, class: "text-accent-strong hover:underline" } %>
  <% table.with_column("State") { |preview| render Ui::BadgeComponent.new(preview.state.humanize, tone: { "active" => :ok, "failed" => :bad, "removing" => :neutral }.fetch(preview.state, :info), data: { preview_state: preview.state }) } %>
  <% table.with_column("Expires", nowrap: true) { |preview| tag.time("in #{time_ago_in_words(preview.expires_at)}", datetime: preview.expires_at.iso8601) } %>
  <% if current_user.can_deploy? %>
    <% table.with_column("", align: :right) do |preview| %>
      <% unless preview.removing? %>
        <%= render Ui::ButtonComponent.new(label: "Destroy", href: preview_path(preview), method: :delete, variant: :danger, size: :sm, confirm: "Remove pr-#{preview.pr_number} from its server now?") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @recent.any? %>
  <%= render Ui::SectionComponent.new(title: "Recently removed") do %>
    <%= render Ui::ListComponent.new do |list| %>
      <% @recent.each do |preview| %>
        <% list.with_item(title: "#{preview.app.name} ##{preview.pr_number}") do |item| %>
          <% item.with_trailing { tag.span(time_ago(preview.updated_at), class: "text-xs text-ink-muted") } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
