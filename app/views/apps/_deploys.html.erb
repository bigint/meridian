<%= titled_section "Ship a version", id: "ship-heading" do %>
  <% if current_user.can_deploy? %>
    <div class="card"><div class="card__body">
      <%= form_with url: app_deploys_path(app), scope: :deploy, class: "fields" do |form| %>
        <div class="field">
          <%= form.label :version %>
          <%= form.text_field :version, list: "versions-#{app.id}", required: true, pattern: App::VERSION_PATTERN, autocomplete: "off", placeholder: app.latest_release&.version, class: "mono" %>
          <datalist id="versions-<%= app.id %>"><% app.releases.limit(20).map(&:version).uniq.each do |version| %><option value="<%= version %>"><% end %></datalist>
          <p class="field__hint">A past release or a new image tag. Meridian commits it to <code><%= app.version_file_path %></code>, and CI runs <code>kamal deploy</code>.</p>
        </div>
        <div><%= form.submit "Deploy", class: "btn btn--primary", data: { turbo_confirm: "Commit this version to #{app.version_file_path}?" } %></div>
      <% end %>
      <% if app.versioned? && app.latest_release %>
        <hr>
        <div>
          <%= button_to "Redeploy", app_redeploy_path(app), class: "btn btn--small",
                form: { data: { turbo_confirm: "Run the deploy workflow again for the version in #{app.version_file_path}? Use this after rotating a secret." } } %>
        </div>
      <% end %>
    </div></div>
  <% else %>
    <p class="txt-muted">Deployers and admins can deploy and roll back.</p>
  <% end %>
<% end %>

<%= titled_section "Current deploy", id: "deploy-heading" do %>
  <% if (deploy = app.current_deploy) %>
    <%= render "apps/deploy_progress", deploy: deploy, app: app %>
  <% else %>
    <p class="txt-muted">No deploys through Meridian yet.</p>
  <% end %>
<% end %>
