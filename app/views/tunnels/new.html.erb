<% content_for :title, "Set up a tunnel" %>
<%= page_header "Set up a tunnel", meta: "One Cloudflare Tunnel for every app: a connector on each server, no open ports, and HTTPS from Cloudflare." do %>
  <%= link_to "All tunnels", tunnels_path, class: "btn" %>
<% end %>

<% if @setup.nil? %>
  <%= empty_state "No projects yet", icon_name: :projects do %>
    <p>Add a project first. A tunnel serves apps Meridian already knows from Git.</p>
  <% end %>
<% else %>
  <% setup = @setup %>
  <div class="split">
    <div class="split__main">
      <section aria-labelledby="phase-cloudflare">
        <h2 id="phase-cloudflare" class="walk__phase">In Cloudflare</h2>
        <ol class="walk">
          <%= render layout: "tunnels/step", locals: { number: 1, title: "Create the tunnel", done: false } do %>
            <p class="walk__text">Open <strong>Networking → Tunnels</strong> and click <strong>Create Tunnel</strong>. One tunnel serves every app.</p>
            <dl class="facts"><dt>Tunnel name</dt><dd><%= copyable setup.name %></dd></dl>
          <% end %>

          <%= render layout: "tunnels/step", locals: { number: 2, title: "Copy its token", done: false } do %>
            <p class="walk__text">Under <strong>Install cloudflared connector</strong>, choose <strong>Docker</strong> and copy the command. You need only the long value after <code>--token</code>.</p>
            <p class="walk__note">Don't run the command. Kamal runs a connector on each server in step 5.</p>
          <% end %>
        </ol>
      </section>

      <section aria-labelledby="phase-git">
        <h2 id="phase-git" class="walk__phase">In Git <span class="walk__where"><%= setup.project.repo_full_name %></span></h2>
        <ol class="walk">
          <%= render layout: "tunnels/step", locals: { number: 3, title: "Save the token", done: setup.token_saved? } do %>
            <p class="walk__text">Set it on the <%= link_to "Secrets", secrets_path(anchor: "project-#{setup.project.id}") %> page, and add the line below to <code>.kamal/secrets</code> so Kamal can read it.</p>
            <dl class="facts">
              <dt>Secret</dt><dd><%= copyable setup.secret_name %></dd>
              <dt>.kamal/secrets</dt><dd><%= copyable setup.secrets_line %></dd>
            </dl>
          <% end %>

          <%= render layout: "tunnels/step", locals: { number: 4, title: "Add the connectors", done: setup.in_config? } do %>
            <p class="walk__text">Commit this as <code><%= setup.config_path %></code>: one connector on each of the <%= pluralize(setup.hosts.size, "server") %> picked on the right. It runs only accessories, so Kamal never deploys an app from it.</p>
            <% setup.gaps.each do |coverage| %>
              <%= alert_box :warn, title: "#{coverage.app.name} isn't on every one of these servers" do %>
                <p>It's missing on <%= safe_join(coverage.missing.map { tag.code(it) }, ", ") %>. Add them to <code><%= coverage.app.config_path %></code> and deploy it before routing it, or Cloudflare will send some of its requests where kamal-proxy answers 404.</p>
              <% end %>
            <% end %>
            <%= render "shared/code_block", code: setup.edge_config, label: setup.config_path %>
          <% end %>
        </ol>
      </section>

      <section aria-labelledby="phase-servers">
        <h2 id="phase-servers" class="walk__phase">On the servers</h2>
        <ol class="walk">
          <%= render layout: "tunnels/step", locals: { number: 5, title: "Start the connectors", done: setup.running? } do %>
            <p class="walk__text">Run this once, from a machine that can SSH to the servers, with <code><%= setup.secret_name %></code> in its environment. <code>kamal deploy</code> doesn't start accessories.</p>
            <%= render "shared/code_block", code: setup.boot_command, label: "Terminal" %>
          <% end %>
        </ol>
      </section>

      <section aria-labelledby="phase-routes">
        <h2 id="phase-routes" class="walk__phase">In Cloudflare</h2>
        <ol class="walk">
          <%= render layout: "tunnels/step", locals: { number: 6, title: "Route each app's hostname", done: false } do %>
            <p class="walk__text">On the tunnel's <strong>Routes</strong> tab, add a <strong>Published application</strong> for each hostname, all to the same service URL. Cloudflare creates the DNS records.</p>
            <dl class="facts">
              <dt>Service URL</dt><dd><%= copyable "http://kamal-proxy:80" %></dd>
              <% setup.served.each do |coverage| %>
                <dt><%= coverage.app.name %></dt>
                <dd class="flex flex-wrap gap-s"><% coverage.app.hostnames.each do |hostname| %><%= copyable hostname %><% end %></dd>
              <% end %>
            </dl>
            <% if setup.served.none? %><p class="walk__note">No app runs on all of these servers yet, so none is ready to route.</p><% end %>
            <p class="walk__note">Serving a hostname the app doesn't answer to? Set <strong>HTTP Host Header</strong> to one it does, under <strong>Additional application settings → HTTP</strong>. Keep hostnames one level below the domain: Cloudflare's free certificate covers <code>app.example.com</code>, not <code>app.team.example.com</code>. Check each record under <strong>DNS → Records</strong>; if one is missing, add a proxied CNAME to <code>&lt;tunnel ID&gt;.cfargotunnel.com</code>.</p>
          <% end %>

          <%= render layout: "tunnels/step", locals: { number: 7, title: "Check it", done: setup.running? && setup.gaps.none? } do %>
            <p class="walk__text">The <%= link_to "Tunnels", tunnels_path %> page shows every connector <em>running</em> and no app missing from a connector's server, and Cloudflare shows the tunnel as <strong>Healthy</strong> with one replica per server.</p>
          <% end %>
        </ol>
      </section>
    </div>

    <aside class="split__aside">
      <%= form_with url: new_tunnel_path, method: :get, class: "panel", data: { controller: "autosubmit" } do |form| %>
        <% if @projects.many? %>
          <div class="field">
            <%= form.label :project, "Project" %>
            <%= form.select :project, @projects.map { [ it.name, it.id ] }, { selected: setup.project.id }, data: { action: "autosubmit#submit" } %>
          </div>
        <% else %>
          <%= form.hidden_field :project, value: setup.project.id %>
        <% end %>

        <fieldset class="field">
          <legend>Connector servers</legend>
          <% setup.candidates.each do |server| %>
            <% apps_here = setup.apps.count { it.servers.include?(server) } %>
            <label class="check">
              <%= check_box_tag "hosts[]", server.hostname, setup.hosts.include?(server.hostname), id: "host-#{server.id}", data: { action: "autosubmit#submit" } %>
              <span><span class="mono txt-small"><%= server.name %></span> <span class="txt-small txt-faint"><%= pluralize(apps_here, "app") %></span></span>
            </label>
          <% end %>
          <p class="field__hint">Every app the tunnel serves must run on all of these.</p>
        </fieldset>
        <noscript><%= form.submit "Show", name: nil, class: "btn" %></noscript>

        <dl class="facts">
          <dt>Ready to route</dt><dd><%= setup.served.any? ? setup.served.map { it.app.name }.join(", ") : tag.span("none", class: "txt-faint") %></dd>
          <% if setup.gaps.any? %><dt>Not on all</dt><dd><%= setup.gaps.map { it.app.name }.join(", ") %></dd><% end %>
          <dt>Token</dt><dd><%= setup.token_saved? ? badge("set", tone: :ok) : badge("not set here") %></dd>
          <dt>Connectors</dt>
          <dd>
            <% if setup.tunnel %>
              <% running = setup.tunnel.connectors.count { it.state == :running } %>
              <%= badge("#{running} of #{setup.tunnel.connectors.size} running", tone: running == setup.tunnel.connectors.size ? :ok : :warn) %>
            <% else %>
              <span class="txt-faint">not in Git yet</span>
            <% end %>
          </dd>
        </dl>
      <% end %>
    </aside>
  </div>
<% end %>
