<%# The map's side panel: one place, what runs on each of its servers, and
    what it shares with other places. locals: map, site %>
<% region = place_region(site) %>
<% neighbours = map.neighbours(site).sort_by { |other, apps| [ -apps.size, other.name ] } %>
<div class="stack-l" data-place-inspector>
  <div class="flex-col gap-s">
    <p class="panel__kicker">PLACE</p>
    <h2 class="panel__title"><%= site.name %></h2>
    <div class="flex flex-wrap items-center gap-s txt-muted">
      <% if map.deploying?(site) %><%= badge "↗ Deploying", tone: :info %><% end %>
      <%= state_badge site.state %>
      <% if region %><code class="txt-small"><%= region %></code><% end %>
      <span class="txt-small"><%= place_coordinates(site) %></span>
    </div>
    <p class="txt-muted"><%= place_summary(site) %></p>
  </div>

  <%= titled_section "Servers", count: site.servers.size, id: "place-servers" do %>
    <ul class="rows">
      <% site.servers.sort_by(&:name).each do |server| %>
        <li class="row row--stacked">
          <%= link_to server.name, server, class: "mono txt-small txt-strong break-all" %>
          <div class="flex flex-wrap items-center gap">
            <% site.cells.select { it.server == server }.sort_by { it.app.name }.each do |cell| %>
              <span class="flex items-center gap-s"><%= version_cell cell %><%= link_to cell.app.name, cell.app, class: "txt-muted" %></span>
            <% end %>
            <span class="ml-auto"><%= agent_status(server) %></span>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= titled_section "Shares apps with", id: "place-neighbours" do %>
    <% if neighbours.any? %>
      <p class="txt-muted">
        <%= safe_join(neighbours.map { |other, apps| safe_join([ link_to(other.name, map_place_path(other), class: "link"), " (#{apps.map(&:service).uniq.join(", ")})" ]) }, " · ") %>
      </p>
    <% else %>
      <p class="txt-muted">No other place runs the same apps.</p>
    <% end %>
  <% end %>

  <% if (note = place_note(map, site)) %>
    <p class="card card__body"><%= note %></p>
  <% end %>

  <div class="flex flex-wrap gap-s">
    <%= link_to "Open on the board", (region ? board_path(region: region) : board_path), class: "btn btn--small" %>
    <% if site.servers.one? %><%= link_to "Open server", site.servers.first, class: "btn btn--small btn--plain" %><% end %>
  </div>
</div>
