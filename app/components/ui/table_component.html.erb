<%= tag.div class: classes("relative overflow-x-auto rounded-lg border border-line", @html.delete(:class)), **@html do %>
  <table class="w-full text-sm">
    <thead class="bg-surface">
      <tr>
        <% columns.each do |column| %>
          <th scope="col" class="<%= classes("px-3 py-2 text-xs font-medium uppercase tracking-wide text-ink-muted whitespace-nowrap", column.align == :right ? "text-right" : "text-left") %>"><%= column.label %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @rows.each do |row| %>
        <tr class="border-t border-line hover:bg-surface">
          <% columns.each do |column| %>
            <% if column.header %>
              <th scope="row" class="<%= classes(cell_class(column), "text-left font-medium text-ink") %>"><%= column.value(row) %></th>
            <% else %>
              <td class="<%= classes(cell_class(column), "text-ink-muted") %>"><%= column.value(row) %></td>
            <% end %>
          <% end %>
        </tr>
      <% end %>
      <% if @rows.none? %>
        <tr class="border-t border-line"><td colspan="<%= columns.size %>" class="px-3 py-6 text-center text-ink-faint"><%= @empty %></td></tr>
      <% end %>
    </tbody>
  </table>
<% end %>
