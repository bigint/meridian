<details class="disclosure" <%= "open" if board.filters.except(:view, :page, :state).any? %>>
  <summary>Filters</summary>
  <%= form_with url: board_path(anchor: "everything"), method: :get, class: "filters", data: { turbo_action: "replace" } do |form| %>
    <%= form.hidden_field :view, value: board.view %>
    <%= form.hidden_field :state, value: board.state if board.state %>
    <div><%= form.label :app %><%= form.search_field :app, value: board.filters[:app], placeholder: "Service" %></div>
    <div><%= form.label :project %><%= form.select :project, projects.map { [ it.name, it.id ] }, { include_blank: "All", selected: board.filters[:project] } %></div>
    <% Board::LABELS.each do |key| %>
      <div><%= form.label key %><%= form.select key, board.label_values(key), { include_blank: "All", selected: board.filters[key.to_sym] } %></div>
    <% end %>
    <div><%= form.label :group, "Group by" %><%= form.select :group, [ [ "Automatic", "" ], [ "Nothing", "none" ], *Board::LABELS.map { [ it.capitalize, it ] } ], selected: board.filters[:group] %></div>
    <%= form.submit "Apply", class: "button", name: nil %>
    <%= link_to "Clear", board_path(view: board.view, anchor: "everything"), class: "button" if board.filters.except(:view).any? %>
  <% end %>
</details>
