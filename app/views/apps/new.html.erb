<% content_for :title, "New app" %>
<%= render Ui::PageHeaderComponent.new(title: "New app", subtitle: "Meridian writes a Kamal config from a template, checks it with Kamal, and opens a pull request on the infra repository. Nothing runs until it is merged.") %>

<%= form_with model: @draft, url: apps_path, scope: :app_draft, class: "space-y-6" do |form| %>
  <%= render "shared/errors", record: @draft %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render Ui::CardComponent.new(title: "The app") do %>
      <div class="space-y-4">
        <%= form.field :project_id, label: "Infra repository" do %><%= form.select :project_id, Project.order(:name).map { [ "#{it.name} (#{it.repo_full_name})", it.id ] } %><% end %>
        <%= form.field :service, label: "Name", hint: safe_join([ "Kamal's ", tag.code("service"), ". Lowercase." ]), required: true, placeholder: "shop", pattern: "[a-z0-9][a-z0-9_\\-]*" %>
        <%= form.field :source_repo, label: "Source repository", hint: "Where the app's code and Dockerfile live. Previews watch its pull requests.", required: true, placeholder: "acme/shop" %>
        <fieldset class="space-y-1.5">
          <legend class="mb-1 text-xs font-medium text-ink-muted">Kind</legend>
          <% App::KINDS.each do |kind| %>
            <label class="flex items-center gap-2 text-sm"><%= form.radio_button :kind, kind %> <span class="font-medium"><%= kind.capitalize %></span> <span class="text-xs text-ink-muted"><%= AppDraft::DESCRIPTIONS[kind] %>, port <%= AppDraft::PORTS[kind] %></span></label>
          <% end %>
        </fieldset>
        <%= form.field :hostname, required: true, placeholder: "shop.example.com" %>
      </div>
    <% end %>

    <%= render Ui::CardComponent.new(title: "Where it runs") do %>
      <div class="space-y-4">
        <%= form.field :server_ids, label: "Servers", hint: "Hold ⌘ or Ctrl to choose several." do %>
          <%= form.select :server_ids, Server.ordered.group_by { it.label("region") || "unlabelled" }.sort.map { |region, servers| [ region, servers.map { [ it.name, it.id ] } ] }, {}, multiple: true, size: 10, grouped: true %>
        <% end %>
        <%= form.field :label_selector, label: "…or every server with these labels", placeholder: "role=web,region=sgp" %>
        <%= form.field :destination, hint: "Optional. Writes a base config plus a destination file.", placeholder: "production" %>
        <div class="grid gap-4 sm:grid-cols-3">
          <%= form.field :app_port, label: "Port" do %><%= form.number_field :app_port, placeholder: "by kind" %><% end %>
          <%= form.field :registry %>
          <%= form.field :version, label: "First version" %>
        </div>
        <p class="text-xs text-ink-muted">The first version is the image tag CI deploys once the pull request is merged.</p>
      </div>
    <% end %>
  </div>

  <div class="flex gap-2">
    <%= form.submit "Open pull request" %>
    <%= render Ui::ButtonComponent.new(label: "Cancel", href: apps_path, variant: :ghost) %>
  </div>
<% end %>
