<div class="relative overflow-x-auto rounded-lg border border-line">
  <table data-board-grid class="w-full border-separate border-spacing-0 text-[13px]">
    <% if apps_view? %>
      <thead>
        <% if grouped? || groups.size > 1 %>
          <tr>
            <td class="sticky left-0 z-10 bg-canvas" colspan="2"></td>
            <% groups.each do |group| %>
              <th scope="colgroup" colspan="<%= group.columns.size %>" class="border-l border-line px-2 pt-2 text-left text-[11px] font-semibold whitespace-nowrap text-ink"><%= group_title(group) %></th>
            <% end %>
          </tr>
        <% end %>
        <tr>
          <th scope="col" class="sticky left-0 z-10 bg-canvas px-3 py-2 text-left text-[11px] font-semibold uppercase tracking-wide text-ink-muted">App</th>
          <th scope="col" class="px-2 py-2 text-left text-[11px] font-semibold uppercase tracking-wide text-ink-muted">Git</th>
          <% groups.each do |group| %>
            <% group.columns.each_with_index do |server, index| %>
              <th scope="col" class="<%= classes("px-1 py-2 text-center align-bottom", ("border-l border-line" if index.zero?)) %>">
                <%= link_to server_label(server), server, title: server.name, class: "inline-block max-w-24 truncate font-mono text-[10px] font-normal text-ink-muted hover:text-accent" %>
              </th>
            <% end %>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @board.page_rows.each do |app| %>
          <tr class="<%= row_class(app) %>">
            <th scope="row" class="<%= sticky_class(app) %>"><%= row_link(app) %></th>
            <td class="border-t border-line px-2 py-1.5 font-mono text-xs whitespace-nowrap text-ink-muted"><%= release(app)&.first(12) || "–" %></td>
            <% groups.each do |group| %>
              <% group.columns.each_with_index do |server, index| %>
                <td class="<%= classes("border-t border-line px-1 py-1.5 text-center", ("border-l" if index.zero?)) %>">
                  <% if (c = cell(group, app, server)) %><%= render VersionCellComponent.new(cell: c) %><% end %>
                </td>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    <% else %>
      <% apps = all_apps %>
      <thead>
        <tr>
          <th scope="col" class="sticky left-0 z-10 bg-canvas px-3 py-2 text-left text-[11px] font-semibold uppercase tracking-wide text-ink-muted">Server</th>
          <% apps.each do |app| %>
            <th scope="col" class="px-1 py-2 text-center align-bottom">
              <%= link_to app.name, app, title: app.name, class: "inline-block max-w-28 truncate text-[11px] font-medium text-ink-muted hover:text-accent" %>
            </th>
          <% end %>
        </tr>
      </thead>
      <% groups.each do |group| %>
        <tbody>
          <% if grouped? %>
            <tr><th scope="rowgroup" colspan="<%= apps.size + 1 %>" class="border-t border-line bg-surface px-3 py-1.5 text-left text-[11px] font-semibold text-ink"><%= group_title(group) %></th></tr>
          <% end %>
          <% group.rows.each do |server| %>
            <tr class="border-t border-line hover:bg-surface">
              <th scope="row" class="sticky left-0 z-10 max-w-56 border-t border-line bg-canvas px-3 py-1.5 text-left font-normal">
                <%= link_to server_label(server), server, title: server.name, class: "block truncate font-mono text-xs text-ink hover:text-accent" %>
              </th>
              <% apps.each do |app| %>
                <td class="border-t border-line px-1 py-1.5 text-center">
                  <% if (c = cell(group, app, server)) %><%= render VersionCellComponent.new(cell: c) %><% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    <% end %>
  </table>
</div>
