<%= form_with model: user, url: user.persisted? ? settings_user_path(user) : settings_users_path, class: "space-y-6" do |form| %>
  <%= render "shared/errors", record: user %>
  <%= render Ui::CardComponent.new do %>
    <div class="space-y-4">
      <%= form.field :name %>
      <%= form.field :email_address, label: "Email" do %><%= form.email_field :email_address, required: true %><% end %>
      <%= form.field :password, hint: user.persisted? ? "Leave blank to keep the current password." : "At least 12 characters. Share it with them privately." do %>
        <%= form.password_field :password, required: user.new_record?, autocomplete: "new-password", minlength: 12, maxlength: 72 %>
      <% end %>
      <%= form.field :role do %><%= form.select :role, User::ROLES.map { [ it.capitalize, it ] } %><% end %>
    </div>
  <% end %>
  <div class="flex gap-2"><%= form.submit %><%= render Ui::ButtonComponent.new(label: "Cancel", href: settings_users_path, variant: :ghost) %></div>
<% end %>
