<%# The filters of the board and the map. locals: url, filters, projects,
    hidden (values the form keeps, by name), group (whether Group by shows),
    open (whether the disclosure starts open), clear_url (nil hides Clear) %>
<%= disclosure "Filters", open: open do %>
  <%= form_with url: url, method: :get, class: "filters", data: { turbo_action: "replace" } do |form| %>
    <% hidden.compact_blank.each do |name, value| %><%= form.hidden_field name, value: value %><% end %>
    <div class="field"><%= form.label :app %><%= form.search_field :app, value: filters[:app], placeholder: "Service" %></div>
    <div class="field"><%= form.label :project %><%= form.select :project, projects.map { [ it.name, it.id ] }, { include_blank: "All", selected: filters[:project] } %></div>
    <% Board::LABELS.each do |key| %>
      <div class="field"><%= form.label key %><%= form.select key, Board.label_values(key), { include_blank: "All", selected: filters[key.to_sym] } %></div>
    <% end %>
    <% if group %>
      <div class="field"><%= form.label :group, "Group by" %><%= form.select :group, [ [ "Automatic", "" ], [ "Nothing", "none" ], *Board::LABELS.map { [ it.capitalize, it ] } ], { selected: filters[:group] } %></div>
    <% end %>
    <%= form.submit "Apply", name: nil, class: "btn" %>
    <% if clear_url %><%= link_to "Clear", clear_url, class: "btn btn--plain" %><% end %>
  <% end %>
<% end %>
