<% content_for :title, "Edit #{@project.name}" %>
<%= page_header "Edit #{@project.name}" do %>
  <%= button_to "Remove project", project_path(@project), method: :delete, class: "btn btn--danger",
        form: { data: { turbo_confirm: "Remove this project from Meridian? Nothing in Git changes." } } %>
<% end %>
<%= render "form", project: @project %>
