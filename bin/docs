#!/usr/bin/env bash
# The documentation site in docs/, built with Mintlify's CLI (needs Node 20.17+).
#
#   bin/docs            preview at http://localhost:3333
#   bin/docs check      what CI checks: validate, broken links, accessibility
#   bin/docs changelog  only write docs/changelog.mdx from CHANGELOG.md
set -euo pipefail

MINT_VERSION=4.3.97
root="$(cd "$(dirname "$0")/.." && pwd)"
mint() { (cd "$root/docs" && npx --yes "mint@$MINT_VERSION" "$@"); }

# The Changelog page is CHANGELOG.md, rendered; it is never committed.
ruby "$root/script/docs_changelog.rb" > /dev/null

case "${1:-dev}" in
  dev) mint dev --port "${PORT:-3333}" --no-open ;;
  check)
    mint validate
    mint broken-links
    mint a11y
    ;;
  changelog) ;;
  *) echo "usage: bin/docs [dev|check|changelog]" >&2; exit 1 ;;
esac
