<section aria-labelledby="<%= @id %>" class="space-y-3">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 id="<%= @id %>" class="text-xs font-semibold uppercase tracking-wider text-ink-muted">
      <%= @title %><% if @count %> <span class="ml-1 font-mono text-ink-faint"><%= @count %></span><% end %>
    </h2>
    <% if actions? %><div class="flex items-center gap-2"><%= actions %></div><% end %>
  </div>
  <%= content %>
</section>
