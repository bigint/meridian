<%= render Ui::ListComponent.new do |list| %>
  <% list.with_item(title: "web is drifted on 2 servers", href: "#") do |item| %>
    <% item.with_leading { render Ui::AvatarComponent.new(state: "drifted") } %>
    <% item.with_subtitle { "Config says v42; ap-south-1a-web-1 runs v41." } %>
    <% item.with_trailing { render Ui::ButtonComponent.new(label: "Redeploy", size: :sm) } %>
  <% end %>
  <% list.with_item(title: "Ana deployed api v17") do |item| %>
    <% item.with_leading { render Ui::AvatarComponent.new(name: "Ana Lima") } %>
    <% item.with_trailing { tag.span("3 minutes ago", class: "text-xs text-ink-muted") } %>
  <% end %>
<% end %>
