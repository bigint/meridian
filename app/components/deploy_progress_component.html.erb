<%= render Ui::CardComponent.new(padded: false) do |card| %>
  <% card.with_header do %>
    <span class="flex items-center gap-2"><%= render Ui::BadgeComponent.new(@deploy.state_label, tone: tone) %><span><%= heading %></span></span>
    <span class="text-xs font-normal text-ink-muted"><%= helpers.time_ago(@deploy.created_at) %></span>
  <% end %>
  <div class="flex flex-wrap gap-x-4 gap-y-1 border-b border-line px-4 py-2 text-xs text-ink-muted">
    <span>By <%= @deploy.actor&.display_name || "Git" %></span>
    <span>Commit <%= link_to @deploy.commit_sha.first(7), @app.project.git.commit_url(@deploy.commit_sha), class: "font-mono text-accent hover:underline" %></span>
    <% if @deploy.ci_url %><%= link_to "CI run ↗", @deploy.ci_url, class: "text-accent hover:underline" %><% end %>
  </div>
  <ul class="divide-y divide-line">
    <% @deploy.progress.each do |server, versions, done| %>
      <li class="flex items-center justify-between gap-3 px-4 py-2">
        <%= link_to server.short_name, server, title: server.name, class: "font-mono text-xs hover:text-accent" %>
        <span class="flex items-center gap-2">
          <code class="text-xs text-ink-muted"><%= versions.join(", ").presence || "–" %></code>
          <%= render Ui::BadgeComponent.new(done ? "✓ Running #{@deploy.version}" : "… Waiting", tone: done ? :ok : :neutral) %>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>
